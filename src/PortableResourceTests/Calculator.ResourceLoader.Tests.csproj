<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NativeCalculatorLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(MSBuildProjectDirectory)/../../build/portable/src/CalculatorNative/libcalculator_engine.dylib</NativeCalculatorLibrary>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../Calculator.ResourceLoader/Calculator.ResourceLoader.csproj" />
    <ProjectReference Include="../Frontends/Calculator.Managed/Calculator.Managed.csproj" />
    <Content Include="$(NativeCalculatorLibrary)"
             Condition="'$(NativeCalculatorLibrary)' != '' and Exists('$(NativeCalculatorLibrary)')"
             Link="libcalculator_engine.dylib"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeCalculatorLibrary"
          BeforeTargets="Build"
          Condition="'$(NativeCalculatorLibrary)' != '' and !Exists('$(NativeCalculatorLibrary)')">
    <Error Text="Native calculator library not found. Configure and build the repository CMake project first." />
  </Target>
</Project>
