<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Calculator.Avalonia"
        xmlns:managed="using:Calculator.Managed"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:shell="using:Calculator.Avalonia.Shell"
        xmlns:controls="using:Calculator.Avalonia.Controls"
        x:Class="Calculator.Avalonia.MainWindow"
        x:DataType="managed:CalculatorViewModel"
        Width="524" Height="773"
        MinWidth="320" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#202027"
        Title="{Binding ApplicationName}">

  <Grid>
    <Border Classes="windowSurface"
            Classes.noBackdrop="{Binding !UseMicaEffect}"
            Classes.inactive="{Binding !IsActive, RelativeSource={RelativeSource AncestorType=Window}}"
            Classes.nativeFrame="{Binding UsesNativeWindowGeometry}"
            Classes.squareCorners="{Binding UsesSquareWindowCorners}"
            ClipToBounds="True"
            BorderBrush="{DynamicResource CalculatorBorderBrush}">
    <Border.Transitions>
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25">
          <BrushTransition.Easing>
            <SplineEasing X1="0.55" Y1="0.55" X2="0" Y2="1" />
          </BrushTransition.Easing>
        </BrushTransition>
      </Transitions>
    </Border.Transitions>
    <Grid RowDefinitions="Auto,48,22*,72*,0,32*,308*">
      <shell:WindowChrome Grid.Row="0" x:Name="TitleBarChrome" />

      <!-- Calculator and Settings are separate page surfaces beneath the
           shared title bar. Keep the inactive page out of layout and hit
           testing instead of covering it with a transparent overlay. -->
      <Grid Grid.Row="1" Grid.RowSpan="6" RowDefinitions="48,22*,72*,0,32*,308*"
            IsVisible="{Binding !IsSettingsOpen}">
      <Grid x:Name="CalculatorResponsiveLayout" Grid.RowSpan="6" ColumnDefinitions="*,0">
      <local:NavigationCulledGrid x:Name="CalculatorPageContent" Grid.RowSpan="6"
                                 Classes="calculatorPageContent"
                                 Classes.paneOpen="{Binding IsNavigationPaneOpen}">
      <local:NavigationCulledGrid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="22*" MinHeight="0" />
        <RowDefinition Height="72*" MinHeight="20" />
        <RowDefinition Height="0" />
        <RowDefinition Height="32*" MinHeight="0" />
        <RowDefinition Height="308*" MinHeight="0" />
      </local:NavigationCulledGrid.RowDefinitions>
      <!-- Hamburger/category/history row from MainPage + Calculator. -->
      <Grid Grid.Row="0" ColumnDefinitions="68,Auto,62,*,56">
        <TextBlock Grid.Column="1" Classes="pageHeading" VerticalAlignment="Center" Text="{Binding ModeDisplayName}" />
        <Button Grid.Column="2" Classes="chromeButton" Margin="10,3,0,3"
                AutomationProperties.Name="{Binding AlwaysOnTopAutomationName}"
                IsVisible="{Binding CanEnterAlwaysOnTop}"
                ToolTip.Placement="Bottom"
                Click="AlwaysOnTop_OnClick">
          <ToolTip.Tip>
            <TextBlock Text="{Binding AlwaysOnTopTooltip}" />
          </ToolTip.Tip>
          <TextBlock Classes="alwaysOnTopGlyph" Text="{Binding AlwaysOnTopGlyph}" />
        </Button>
        <Button x:Name="HistoryButton" Grid.Column="4" Classes="chromeButton"
                AutomationProperties.Name="{Binding HistoryAutomationName}"
                IsVisible="{Binding IsHistoryButtonVisible}"
                Command="{Binding ToggleHistoryCommand}" ToolTip.Tip="{Binding HistoryTooltip}">
          <Canvas Width="28" Height="28">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 6,9 A 9,9 0 1 1 5,16 M 3,6 L 3,12 L 9,12 M 14,8 L 14,14 L 18,16" />
          </Canvas>
        </Button>
      </Grid>

      <controls:CalculatorDisplay Grid.Row="1" Grid.RowSpan="2" x:Name="Display" />

      <controls:MemoryPanel Grid.Row="4" x:Name="MemoryRow" />

      <!-- Scientific mode reuses the source display and memory surfaces. Its
           extra 32-star row is owned by Calculator.xaml's Scientific state. -->
      <Grid Grid.Row="3" Margin="3,0" ColumnDefinitions="80,80,*"
            IsVisible="{Binding IsScientificMode}">
        <Button x:Name="ScientificAngleButton" Classes="memoryButton" Content="{Binding ScientificAngleLabel}"
                IsEnabled="{Binding !IsError}"
                Command="{Binding CycleScientificAngleCommand}" />
        <Button x:Name="ScientificNotationButton" Grid.Column="1" Classes="memoryButton"
                Classes.selected="{Binding IsScientificNotation}"
                IsEnabled="{Binding !IsError}"
                Content="F-E" Command="{Binding ToggleScientificNotationCommand}" />
      </Grid>

      <!-- Programmer mode keeps Microsoft's original vertical topology:
           four radix rows, a compact input/word-size selector, then the
           six-row, five-column integer keypad (or 64-bit flip surface). -->
      <Grid x:Name="ProgrammerPanel" Grid.Row="3" Grid.RowSpan="3"
            RowDefinitions="96,34,*" IsVisible="{Binding IsProgrammerMode}"
            x:CompileBindings="False">
        <Grid Margin="4,0" RowDefinitions="*,*,*,*">
          <Button x:Name="ProgrammerHexRadixButton" Classes="memoryButton programmerRadix" Classes.selected="{Binding IsProgrammerHexadecimal}"
                  HorizontalContentAlignment="Stretch" Padding="12,0"
                  Command="{Binding SelectProgrammerRadixCommand}" CommandParameter="Hexadecimal">
            <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
              <TextBlock VerticalAlignment="Center" FontSize="12" Text="HEX" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ProgrammerHexDisplay}" />
            </Grid>
          </Button>
          <Button x:Name="ProgrammerDecimalRadixButton" Grid.Row="1" Classes="memoryButton programmerRadix" Classes.selected="{Binding IsProgrammerDecimal}"
                  HorizontalContentAlignment="Stretch" Padding="12,0"
                  Command="{Binding SelectProgrammerRadixCommand}" CommandParameter="Decimal">
            <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
              <TextBlock VerticalAlignment="Center" FontSize="12" Text="DEC" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ProgrammerDecimalDisplay}" />
            </Grid>
          </Button>
          <Button x:Name="ProgrammerOctalRadixButton" Grid.Row="2" Classes="memoryButton programmerRadix" Classes.selected="{Binding IsProgrammerOctal}"
                  HorizontalContentAlignment="Stretch" Padding="12,0"
                  Command="{Binding SelectProgrammerRadixCommand}" CommandParameter="Octal">
            <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
              <TextBlock VerticalAlignment="Center" FontSize="12" Text="OCT" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ProgrammerOctalDisplay}" />
            </Grid>
          </Button>
          <Button x:Name="ProgrammerBinaryRadixButton" Grid.Row="3" Classes="memoryButton programmerRadix" Classes.selected="{Binding IsProgrammerBinary}"
                  HorizontalContentAlignment="Stretch" Padding="12,0"
                  Command="{Binding SelectProgrammerRadixCommand}" CommandParameter="Binary">
            <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
              <TextBlock VerticalAlignment="Center" FontSize="12" Text="BIN" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding ProgrammerBinaryDisplay}" />
            </Grid>
          </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="3,0" ColumnDefinitions="80,80,*,80">
          <Button Classes="memoryButton" FontFamily="{StaticResource CalculatorIconFont}"
                  Content="&#xE75F;" Command="{Binding ToggleProgrammerBitFlipCommand}" />
          <Button Grid.Column="1" Classes="memoryButton" FontFamily="{StaticResource CalculatorIconFont}"
                  Classes.selected="{Binding IsProgrammerBitFlipMode}"
                  Content="&#xF7D0;" Command="{Binding ToggleProgrammerBitFlipCommand}" />
          <Button x:Name="ProgrammerWordSizeButton" Grid.Column="3" Classes="memoryButton" IsEnabled="{Binding !IsError}"
                  Content="{Binding ProgrammerWordSizeLabel}" Command="{Binding CycleProgrammerWordSizeCommand}" />
        </Grid>

        <Grid x:Name="ProgrammerNumpadPanel" Grid.Row="2" Margin="3,0,3,3"
              RowDefinitions="Auto,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*"
              IsVisible="{Binding !IsProgrammerBitFlipMode}">
          <StackPanel Grid.ColumnSpan="5" Classes="scientificOperatorPanel" Orientation="Horizontal">
            <Button Classes="memoryButton" IsEnabled="{Binding !IsError}">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="16" Text="&#xF895;" />
                  <TextBlock x:Name="ProgrammerBitwiseLabel" Margin="8,0,0,0" Text="{Binding BitwiseName}" />
                </StackPanel>
              </Button.Content>
              <Button.Flyout>
                <Flyout Placement="Bottom">
                  <Grid Width="258" Height="96" RowDefinitions="*,*" ColumnDefinitions="*,*,*">
                    <Button Classes="calcButton operator" Content="AND" Command="{Binding SendCommandCommand}" CommandParameter="And" />
                    <Button Grid.Column="1" Classes="calcButton operator" Content="OR" Command="{Binding SendCommandCommand}" CommandParameter="Or" />
                    <Button Grid.Column="2" Classes="calcButton operator" Content="NOT" Command="{Binding SendCommandCommand}" CommandParameter="Not" />
                    <Button Grid.Row="1" Classes="calcButton operator" Content="NAND" Command="{Binding SendCommandCommand}" CommandParameter="Nand" />
                    <Button Grid.Row="1" Grid.Column="1" Classes="calcButton operator" Content="NOR" Command="{Binding SendCommandCommand}" CommandParameter="Nor" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="calcButton operator" Content="XOR" Command="{Binding SendCommandCommand}" CommandParameter="Xor" />
                  </Grid>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="memoryButton" IsEnabled="{Binding !IsError}">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="16" Text="&#xF896;" />
                  <TextBlock x:Name="ProgrammerBitShiftLabel" Margin="8,0,0,0" Text="{Binding BitShiftName}" />
                </StackPanel>
              </Button.Content>
              <Button.Flyout>
                <Flyout Placement="Bottom">
                  <StackPanel Width="230" Margin="8">
                    <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding ArithmeticShiftName}" IsChecked="{Binding IsProgrammerArithmeticShift}"
                                 Command="{Binding SelectProgrammerShiftModeCommand}" CommandParameter="Arithmetic" />
                    <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding LogicalShiftName}" IsChecked="{Binding IsProgrammerLogicalShift}"
                                 Command="{Binding SelectProgrammerShiftModeCommand}" CommandParameter="Logical" />
                    <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding RotateCircularShiftName}" IsChecked="{Binding IsProgrammerRotateShift}"
                                 Command="{Binding SelectProgrammerShiftModeCommand}" CommandParameter="Rotate" />
                    <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding RotateCarryShiftName}" IsChecked="{Binding IsProgrammerRotateCarryShift}"
                                 Command="{Binding SelectProgrammerShiftModeCommand}" CommandParameter="RotateCarry" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <Button x:Name="ProgrammerLeftShiftButton" Grid.Row="1" Grid.Column="1"
                  Classes="calcButton operator" FontFamily="{StaticResource CalculatorIconFont}"
                  Content="&#xF88E;" IsEnabled="{Binding !IsError}"
                  Command="{Binding ExecuteProgrammerLeftShiftCommand}" />
          <Button x:Name="ProgrammerRightShiftButton" Grid.Row="1" Grid.Column="2"
                  Classes="calcButton operator" FontFamily="{StaticResource CalculatorIconFont}"
                  Content="&#xF88F;" IsEnabled="{Binding !IsError}"
                  Command="{Binding ExecuteProgrammerRightShiftCommand}" />
          <Grid Grid.Row="1" Grid.Column="3">
            <Button x:Name="ProgrammerClearButton" Classes="calcButton operator" Content="C"
                    IsVisible="{Binding IsInputEmpty}" Command="{Binding SendCommandCommand}" CommandParameter="Clear" />
            <Button x:Name="ProgrammerClearEntryButton" Classes="calcButton operator" Content="CE"
                    IsVisible="{Binding !IsInputEmpty}" Command="{Binding SendCommandCommand}" CommandParameter="ClearEntry" />
          </Grid>
          <Button x:Name="ProgrammerBackspaceButton" Grid.Row="1" Grid.Column="4"
                  Classes="calcButton operator symbolOperator" Content="&#xE94F;"
                  Command="{Binding SendCommandCommand}" CommandParameter="Backspace" />

          <Button x:Name="ProgrammerAButton" Grid.Row="1" Classes="calcButton numeric" Content="A" IsEnabled="{Binding AreProgrammerHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="A" />
          <Button x:Name="ProgrammerBButton" Grid.Row="2" Classes="calcButton numeric" Content="B" IsEnabled="{Binding AreProgrammerHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="B" />
          <Button x:Name="ProgrammerCButton" Grid.Row="3" Classes="calcButton numeric" Content="C" IsEnabled="{Binding AreProgrammerHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="C" />
          <Button x:Name="ProgrammerDButton" Grid.Row="4" Classes="calcButton numeric" Content="D" IsEnabled="{Binding AreProgrammerHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="D" />
          <Button x:Name="ProgrammerEButton" Grid.Row="5" Classes="calcButton numeric" Content="E" IsEnabled="{Binding AreProgrammerHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="E" />
          <Button x:Name="ProgrammerFButton" Grid.Row="6" Classes="calcButton numeric" Content="F" IsEnabled="{Binding AreProgrammerHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="F" />

          <Button x:Name="ProgrammerOpenParenthesisButton" Grid.Row="2" Grid.Column="1" Classes="calcButton operator" Content="(&#x2009;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="OpenParenthesis" />
          <Button x:Name="ProgrammerCloseParenthesisButton" Grid.Row="2" Grid.Column="2" Classes="calcButton operator" Content="&#x2009;)" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="CloseParenthesis" />
          <Button x:Name="ProgrammerModuloButton" Grid.Row="2" Grid.Column="3" Classes="calcButton operator" Content="%" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Modulo" />
          <Button x:Name="ProgrammerDivideButton" Grid.Row="2" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE94A;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Divide" />

          <Button x:Name="ProgrammerSevenButton" Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="7" IsEnabled="{Binding AreProgrammerTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Seven" />
          <Button x:Name="ProgrammerEightButton" Grid.Row="3" Grid.Column="2" Classes="calcButton numeric" Content="8" IsEnabled="{Binding AreProgrammerEightAndNineEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Eight" />
          <Button x:Name="ProgrammerNineButton" Grid.Row="3" Grid.Column="3" Classes="calcButton numeric" Content="9" IsEnabled="{Binding AreProgrammerEightAndNineEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Nine" />
          <Button x:Name="ProgrammerMultiplyButton" Grid.Row="3" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE947;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Multiply" />
          <Button x:Name="ProgrammerFourButton" Grid.Row="4" Grid.Column="1" Classes="calcButton numeric" Content="4" IsEnabled="{Binding AreProgrammerTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Four" />
          <Button x:Name="ProgrammerFiveButton" Grid.Row="4" Grid.Column="2" Classes="calcButton numeric" Content="5" IsEnabled="{Binding AreProgrammerTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Five" />
          <Button x:Name="ProgrammerSixButton" Grid.Row="4" Grid.Column="3" Classes="calcButton numeric" Content="6" IsEnabled="{Binding AreProgrammerTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Six" />
          <Button x:Name="ProgrammerSubtractButton" Grid.Row="4" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE949;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Subtract" />
          <Button x:Name="ProgrammerOneButton" Grid.Row="5" Grid.Column="1" Classes="calcButton numeric" Content="1" Command="{Binding SendCommandCommand}" CommandParameter="One" />
          <Button x:Name="ProgrammerTwoButton" Grid.Row="5" Grid.Column="2" Classes="calcButton numeric" Content="2" IsEnabled="{Binding AreProgrammerTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Two" />
          <Button x:Name="ProgrammerThreeButton" Grid.Row="5" Grid.Column="3" Classes="calcButton numeric" Content="3" IsEnabled="{Binding AreProgrammerTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Three" />
          <Button x:Name="ProgrammerAddButton" Grid.Row="5" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE948;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Add" />
          <Button x:Name="ProgrammerSignButton" Grid.Row="6" Grid.Column="1" Classes="calcButton numeric symbolOperator" Content="&#xF898;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Sign" />
          <Button x:Name="ProgrammerZeroButton" Grid.Row="6" Grid.Column="2" Classes="calcButton numeric" Content="0" Command="{Binding SendCommandCommand}" CommandParameter="Zero" />
          <Button x:Name="ProgrammerEqualsButton" Grid.Row="6" Grid.Column="4" Classes="calcButton equalsButton symbolOperator" Content="&#xE94E;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Equals" />
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="4,0,4,4" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsProgrammerBitFlipMode}">
          <ItemsControl ItemsSource="{Binding ProgrammerBitGroups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="managed:CalculatorProgrammerBitGroup" x:CompileBindings="False">
                <StackPanel Width="124" Margin="2,3">
                  <ItemsControl ItemsSource="{Binding Bits}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="managed:CalculatorProgrammerBit" x:CompileBindings="False">
                        <Button Height="30" Padding="0" Classes="memoryButton"
                                IsEnabled="{Binding IsEnabled}"
                                Command="{Binding $parent[Window].DataContext.FlipProgrammerBitCommand}"
                                CommandParameter="{Binding}">
                          <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="0" IsVisible="{Binding !IsSet}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" IsVisible="{Binding IsSet}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Margin="4,0" FontSize="11" Opacity="0.65" Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- CalculatorStandardOperators + NumberPad, flattened without changing geometry. -->
      <Grid x:Name="CalculatorKeypadRegion" Grid.Row="5" IsHitTestVisible="False" />
      <Grid x:Name="NumpadPanel" Grid.Row="5" Margin="3,0,3,3"
            RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="*,*,*,*"
            IsVisible="{Binding IsStandardMode}">
        <Button x:Name="PercentButton" Classes="calcButton operator symbolOperator" Content="&#xE94C;" Command="{Binding SendCommandCommand}" CommandParameter="Percent" />
        <Button x:Name="ClearEntryButton" Grid.Column="1" Classes="calcButton operator" Content="CE" FontSize="17.6" Command="{Binding SendCommandCommand}" CommandParameter="ClearEntry" />
        <Button x:Name="ClearButton" Grid.Column="2" Classes="calcButton operator" Content="C" FontSize="17.6" Command="{Binding SendCommandCommand}" CommandParameter="Clear" />
        <Button x:Name="BackspaceButton" Grid.Column="3" Classes="calcButton operator symbolOperator" Content="&#xE94F;" FontSize="19.36" Command="{Binding SendCommandCommand}" CommandParameter="Backspace" />

        <Button Grid.Row="1" Classes="calcButton operator symbolOperator" Content="&#xF7C9;" FontSize="21.78" Command="{Binding SendCommandCommand}" CommandParameter="Reciprocal" />
        <Button Grid.Row="1" Grid.Column="1" Classes="calcButton operator symbolOperator" Content="&#xF7C8;" FontSize="21.78" Command="{Binding SendCommandCommand}" CommandParameter="Square" />
        <Button x:Name="SquareRootButton" Grid.Row="1" Grid.Column="2" Classes="calcButton operator symbolOperator" Content="&#xF899;" FontSize="21.78" Command="{Binding SendCommandCommand}" CommandParameter="SquareRoot" />
        <Button x:Name="DivideButton" Grid.Row="1" Grid.Column="3" Classes="calcButton operator symbolOperator" Content="&#xE94A;" Command="{Binding SendCommandCommand}" CommandParameter="Divide" />

        <Button x:Name="SevenButton" Grid.Row="2" Classes="calcButton numeric" Content="7" Command="{Binding SendCommandCommand}" CommandParameter="Seven" />
        <Button x:Name="EightButton" Grid.Row="2" Grid.Column="1" Classes="calcButton numeric" Content="8" Command="{Binding SendCommandCommand}" CommandParameter="Eight" />
        <Button x:Name="NineButton" Grid.Row="2" Grid.Column="2" Classes="calcButton numeric" Content="9" Command="{Binding SendCommandCommand}" CommandParameter="Nine" />
        <Button x:Name="MultiplyButton" Grid.Row="2" Grid.Column="3" Classes="calcButton operator symbolOperator" Content="&#xE947;" Command="{Binding SendCommandCommand}" CommandParameter="Multiply" />

        <Button x:Name="FourButton" Grid.Row="3" Classes="calcButton numeric" Content="4" Command="{Binding SendCommandCommand}" CommandParameter="Four" />
        <Button x:Name="FiveButton" Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="5" Command="{Binding SendCommandCommand}" CommandParameter="Five" />
        <Button x:Name="SixButton" Grid.Row="3" Grid.Column="2" Classes="calcButton numeric" Content="6" Command="{Binding SendCommandCommand}" CommandParameter="Six" />
        <Button x:Name="SubtractButton" Grid.Row="3" Grid.Column="3" Classes="calcButton operator symbolOperator" Content="&#xE949;" Command="{Binding SendCommandCommand}" CommandParameter="Subtract" />

        <Button x:Name="OneButton" Grid.Row="4" Classes="calcButton numeric" Content="1" Command="{Binding SendCommandCommand}" CommandParameter="One" />
        <Button x:Name="TwoButton" Grid.Row="4" Grid.Column="1" Classes="calcButton numeric" Content="2" Command="{Binding SendCommandCommand}" CommandParameter="Two" />
        <Button x:Name="ThreeButton" Grid.Row="4" Grid.Column="2" Classes="calcButton numeric" Content="3" Command="{Binding SendCommandCommand}" CommandParameter="Three" />
        <Button x:Name="AddButton" Grid.Row="4" Grid.Column="3" Classes="calcButton operator symbolOperator" Content="&#xE948;" Command="{Binding SendCommandCommand}" CommandParameter="Add" />

        <Button x:Name="SignButton" Grid.Row="5" Classes="calcButton numeric symbolOperator" Content="&#xF898;" FontSize="23.1" Command="{Binding SendCommandCommand}" CommandParameter="Sign" />
        <Button x:Name="ZeroButton" Grid.Row="5" Grid.Column="1" Classes="calcButton numeric" Content="0" Command="{Binding SendCommandCommand}" CommandParameter="Zero" />
        <Button x:Name="DecimalButton" Grid.Row="5" Grid.Column="2" Classes="calcButton numeric" Content="{Binding DecimalSeparator}" Command="{Binding SendCommandCommand}" CommandParameter="Decimal" />
        <Button x:Name="EqualsButton" Grid.Row="5" Grid.Column="3" Classes="calcButton equalsButton" Content="&#xE94E;" Command="{Binding SendCommandCommand}" CommandParameter="Equals" />
      </Grid>

      <!-- CalculatorScientificOperators.xaml: one auto operator-panel row and
           seven equal keypad rows across five equal columns. -->
      <Grid x:Name="ScientificNumpadPanel" Grid.Row="5" Margin="3,0,3,3"
            RowDefinitions="Auto,*,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*"
            Classes.scientificError="{Binding IsError}"
            IsVisible="{Binding IsScientificMode}">
        <StackPanel Grid.ColumnSpan="5" Classes="scientificOperatorPanel" Orientation="Horizontal">
          <Button x:Name="ScientificTrigButton" Classes="memoryButton scientificErrorDisabled">
            <Button.Content>
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="operatorPanelGlyph" Margin="0,2,8,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource CalculatorIconFont}" Text="&#xF892;" />
                <TextBlock Classes="operatorPanelText" VerticalAlignment="Center" Text="{Binding TrigonometryName}" />
                <TextBlock Classes="operatorPanelChevron" Margin="8,4,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource CalculatorIconFont}" Text="&#xE70D;" />
              </StackPanel>
            </Button.Content>
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <Grid x:Name="ScientificTrigFlyoutGrid" Width="258" Height="96" RowDefinitions="*,*" ColumnDefinitions="64,*,*,*">
                  <Button x:Name="ScientificTrigShiftButton" Classes="memoryButton" Content="2nd" Command="{Binding ToggleTrigInverseCommand}" />
                  <Button x:Name="ScientificHypButton" Grid.Row="1" Classes="memoryButton" Content="hyp" Command="{Binding ToggleTrigHyperbolicCommand}" />

                  <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="2"
                        RowDefinitions="*,*" ColumnDefinitions="*,*,*"
                        IsVisible="{Binding ShowsRegularTrigFunctions}">
                    <Button x:Name="ScientificSinButton" Classes="calcButton operator" Content="sin" Command="{Binding SendCommandCommand}" CommandParameter="Sin" />
                    <Button x:Name="ScientificCosButton" Grid.Column="1" Classes="calcButton operator" Content="cos" Command="{Binding SendCommandCommand}" CommandParameter="Cos" />
                    <Button x:Name="ScientificTanButton" Grid.Column="2" Classes="calcButton operator" Content="tan" Command="{Binding SendCommandCommand}" CommandParameter="Tan" />
                    <Button x:Name="ScientificSecButton" Grid.Row="1" Classes="calcButton operator" Content="sec" Command="{Binding SendCommandCommand}" CommandParameter="Sec" />
                    <Button x:Name="ScientificCscButton" Grid.Row="1" Grid.Column="1" Classes="calcButton operator" Content="csc" Command="{Binding SendCommandCommand}" CommandParameter="Csc" />
                    <Button x:Name="ScientificCotButton" Grid.Row="1" Grid.Column="2" Classes="calcButton operator" Content="cot" Command="{Binding SendCommandCommand}" CommandParameter="Cot" />
                  </Grid>
                  <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="2"
                        RowDefinitions="*,*" ColumnDefinitions="*,*,*"
                        IsVisible="{Binding ShowsInverseTrigFunctions}">
                    <Button x:Name="ScientificInverseSinButton" Classes="calcButton operator" Content="sin⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseSin" />
                    <Button x:Name="ScientificInverseCosButton" Grid.Column="1" Classes="calcButton operator" Content="cos⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseCos" />
                    <Button x:Name="ScientificInverseTanButton" Grid.Column="2" Classes="calcButton operator" Content="tan⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseTan" />
                    <Button x:Name="ScientificInverseSecButton" Grid.Row="1" Classes="calcButton operator" Content="sec⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseSec" />
                    <Button x:Name="ScientificInverseCscButton" Grid.Row="1" Grid.Column="1" Classes="calcButton operator" Content="csc⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseCsc" />
                    <Button x:Name="ScientificInverseCotButton" Grid.Row="1" Grid.Column="2" Classes="calcButton operator" Content="cot⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseCot" />
                  </Grid>
                  <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="2"
                        RowDefinitions="*,*" ColumnDefinitions="*,*,*"
                        IsVisible="{Binding ShowsHyperbolicTrigFunctions}">
                    <Button x:Name="ScientificSinhButton" Classes="calcButton operator" Content="sinh" Command="{Binding SendCommandCommand}" CommandParameter="Sinh" />
                    <Button x:Name="ScientificCoshButton" Grid.Column="1" Classes="calcButton operator" Content="cosh" Command="{Binding SendCommandCommand}" CommandParameter="Cosh" />
                    <Button x:Name="ScientificTanhButton" Grid.Column="2" Classes="calcButton operator" Content="tanh" Command="{Binding SendCommandCommand}" CommandParameter="Tanh" />
                    <Button x:Name="ScientificSechButton" Grid.Row="1" Classes="calcButton operator" Content="sech" Command="{Binding SendCommandCommand}" CommandParameter="Sech" />
                    <Button x:Name="ScientificCschButton" Grid.Row="1" Grid.Column="1" Classes="calcButton operator" Content="csch" Command="{Binding SendCommandCommand}" CommandParameter="Csch" />
                    <Button x:Name="ScientificCothButton" Grid.Row="1" Grid.Column="2" Classes="calcButton operator" Content="coth" Command="{Binding SendCommandCommand}" CommandParameter="Coth" />
                  </Grid>
                  <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="2"
                        RowDefinitions="*,*" ColumnDefinitions="*,*,*"
                        IsVisible="{Binding ShowsInverseHyperbolicTrigFunctions}">
                    <Button x:Name="ScientificInverseSinhButton" Classes="calcButton operator" Content="sinh⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseSinh" />
                    <Button x:Name="ScientificInverseCoshButton" Grid.Column="1" Classes="calcButton operator" Content="cosh⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseCosh" />
                    <Button x:Name="ScientificInverseTanhButton" Grid.Column="2" Classes="calcButton operator" Content="tanh⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseTanh" />
                    <Button x:Name="ScientificInverseSechButton" Grid.Row="1" Classes="calcButton operator" Content="sech⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseSech" />
                    <Button x:Name="ScientificInverseCschButton" Grid.Row="1" Grid.Column="1" Classes="calcButton operator" Content="csch⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseCsch" />
                    <Button x:Name="ScientificInverseCothButton" Grid.Row="1" Grid.Column="2" Classes="calcButton operator" Content="coth⁻¹" Command="{Binding SendCommandCommand}" CommandParameter="InverseCoth" />
                  </Grid>
                </Grid>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ScientificFunctionButton" Classes="memoryButton scientificErrorDisabled">
            <Button.Content>
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="operatorPanelGlyph" Margin="0,2,8,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource CalculatorIconFont}" Text="&#xF893;" />
                <TextBlock Classes="operatorPanelText" VerticalAlignment="Center" Text="{Binding FunctionName}" />
                <TextBlock Classes="operatorPanelChevron" Margin="8,4,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource CalculatorIconFont}" Text="&#xE70D;" />
              </StackPanel>
            </Button.Content>
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <Grid x:Name="ScientificFunctionFlyoutGrid" Width="194" Height="96" RowDefinitions="*,*" ColumnDefinitions="*,*,*">
                  <Button x:Name="ScientificFlyoutAbsoluteButton" Classes="calcButton operator symbolOperator" Content="&#xF884;" Command="{Binding SendCommandCommand}" CommandParameter="Absolute" />
                  <Button x:Name="ScientificFloorButton" Grid.Column="1" Classes="calcButton operator symbolOperator" Content="&#xF885;" Command="{Binding SendCommandCommand}" CommandParameter="Floor" />
                  <Button x:Name="ScientificCeilingButton" Grid.Column="2" Classes="calcButton operator symbolOperator" Content="&#xF886;" Command="{Binding SendCommandCommand}" CommandParameter="Ceiling" />
                  <Button x:Name="ScientificRandomButton" Grid.Row="1" Classes="calcButton operator" Content="rand" Command="{Binding SendCommandCommand}" CommandParameter="Random" />
                  <Button x:Name="ScientificDmsButton" Grid.Row="1" Grid.Column="1" Classes="calcButton operator symbolOperator" Content="&#xF890;" Command="{Binding SendCommandCommand}" CommandParameter="Dms" />
                  <Button x:Name="ScientificDegreesButton" Grid.Row="1" Grid.Column="2" Classes="calcButton operator symbolOperator" Content="&#xF891;" Command="{Binding SendCommandCommand}" CommandParameter="Degrees" />
                </Grid>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <Button x:Name="ScientificShiftButton" Grid.Row="1" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF897;"
                Command="{Binding ToggleScientificInverseCommand}" />
        <Button x:Name="ScientificPiButton" Grid.Row="1" Grid.Column="1" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7CF;"
                Command="{Binding SendCommandCommand}" CommandParameter="Pi" />
        <Button x:Name="ScientificEulerButton" Grid.Row="1" Grid.Column="2" Classes="calcButton operator scientificErrorDisabled" Content="e"
                Command="{Binding SendCommandCommand}" CommandParameter="Euler" />
        <Grid Grid.Row="1" Grid.Column="3">
          <Button x:Name="ScientificClearEntryButton" Classes="calcButton operator" Content="CE"
                  IsVisible="{Binding !IsInputEmpty}"
                  Command="{Binding SendCommandCommand}" CommandParameter="ClearEntry" />
          <Button x:Name="ScientificClearButton" Classes="calcButton operator" Content="C"
                  IsVisible="{Binding IsInputEmpty}"
                  Command="{Binding SendCommandCommand}" CommandParameter="Clear" />
        </Grid>
        <Button x:Name="ScientificBackspaceButton" Grid.Row="1" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE94F;"
                Command="{Binding SendCommandCommand}" CommandParameter="Backspace" />

        <Grid Grid.Row="2" Grid.RowSpan="6" IsVisible="{Binding !IsScientificInverse}"
              RowDefinitions="*,*,*,*,*,*">
          <Button x:Name="ScientificSquareButton" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7C8;" Command="{Binding SendCommandCommand}" CommandParameter="Square" />
          <Button x:Name="ScientificSquareRootButton" Grid.Row="1" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF899;" Command="{Binding SendCommandCommand}" CommandParameter="SquareRoot" />
          <Button x:Name="ScientificPowerButton" Grid.Row="2" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7CA;" Command="{Binding SendCommandCommand}" CommandParameter="Power" />
          <Button x:Name="ScientificTenPowerButton" Grid.Row="3" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7CC;" Command="{Binding SendCommandCommand}" CommandParameter="TenPowerX" />
          <Button x:Name="ScientificLogButton" Grid.Row="4" Classes="calcButton operator scientificErrorDisabled" Content="log" Command="{Binding SendCommandCommand}" CommandParameter="LogBase10" />
          <Button x:Name="ScientificNaturalLogButton" Grid.Row="5" Classes="calcButton operator scientificErrorDisabled" Content="ln" Command="{Binding SendCommandCommand}" CommandParameter="NaturalLog" />
        </Grid>
        <Grid x:Name="ScientificInverseOperators" Grid.Row="2" Grid.RowSpan="6" IsVisible="{Binding IsScientificInverse}"
              RowDefinitions="*,*,*,*,*,*">
          <Button x:Name="ScientificCubeButton" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7CB;" Command="{Binding SendCommandCommand}" CommandParameter="Cube" />
          <Button x:Name="ScientificCubeRootButton" Grid.Row="1" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF881;" Command="{Binding SendCommandCommand}" CommandParameter="CubeRoot" />
          <Button x:Name="ScientificRootButton" Grid.Row="2" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7CD;" Command="{Binding SendCommandCommand}" CommandParameter="Root" />
          <Button x:Name="ScientificTwoPowerButton" Grid.Row="3" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF882;" Command="{Binding SendCommandCommand}" CommandParameter="TwoPowerX" />
          <Button x:Name="ScientificLogBaseYButton" Grid.Row="4" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF883;" Command="{Binding SendCommandCommand}" CommandParameter="LogBaseY" />
          <Button x:Name="ScientificEPowerButton" Grid.Row="5" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7CE;" Command="{Binding SendCommandCommand}" CommandParameter="EPowerX" />
        </Grid>

        <Button x:Name="ScientificReciprocalButton" Grid.Row="2" Grid.Column="1" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF7C9;" Command="{Binding SendCommandCommand}" CommandParameter="Reciprocal" />
        <Button x:Name="ScientificAbsoluteButton" Grid.Row="2" Grid.Column="2" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF884;" Command="{Binding SendCommandCommand}" CommandParameter="Absolute" />
        <Button x:Name="ScientificExpButton" Grid.Row="2" Grid.Column="3" Classes="calcButton operator scientificErrorDisabled" Content="exp" Command="{Binding SendCommandCommand}" CommandParameter="Exp" />
        <Button x:Name="ScientificModuloButton" Grid.Row="2" Grid.Column="4" Classes="calcButton operator scientificErrorDisabled" Content="mod" Command="{Binding SendCommandCommand}" CommandParameter="Modulo" />

        <Button x:Name="ScientificOpenParenthesisButton" Grid.Row="3" Grid.Column="1" Classes="calcButton operator scientificErrorDisabled" Content="(" Command="{Binding SendCommandCommand}" CommandParameter="OpenParenthesis" />
        <Button x:Name="ScientificCloseParenthesisButton" Grid.Row="3" Grid.Column="2" Classes="calcButton operator scientificErrorDisabled" Content=")" Command="{Binding SendCommandCommand}" CommandParameter="CloseParenthesis" />
        <Button x:Name="ScientificFactorialButton" Grid.Row="3" Grid.Column="3" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xF887;" Command="{Binding SendCommandCommand}" CommandParameter="Factorial" />
        <Button x:Name="ScientificDivideButton" Grid.Row="3" Grid.Column="4" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xE94A;" Command="{Binding SendCommandCommand}" CommandParameter="Divide" />

        <Button x:Name="ScientificSevenButton" Grid.Row="4" Grid.Column="1" Classes="calcButton numeric" Content="7" Command="{Binding SendCommandCommand}" CommandParameter="Seven" />
        <Button x:Name="ScientificEightButton" Grid.Row="4" Grid.Column="2" Classes="calcButton numeric" Content="8" Command="{Binding SendCommandCommand}" CommandParameter="Eight" />
        <Button x:Name="ScientificNineButton" Grid.Row="4" Grid.Column="3" Classes="calcButton numeric" Content="9" Command="{Binding SendCommandCommand}" CommandParameter="Nine" />
        <Button x:Name="ScientificMultiplyButton" Grid.Row="4" Grid.Column="4" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xE947;" Command="{Binding SendCommandCommand}" CommandParameter="Multiply" />
        <Button x:Name="ScientificFourButton" Grid.Row="5" Grid.Column="1" Classes="calcButton numeric" Content="4" Command="{Binding SendCommandCommand}" CommandParameter="Four" />
        <Button x:Name="ScientificFiveButton" Grid.Row="5" Grid.Column="2" Classes="calcButton numeric" Content="5" Command="{Binding SendCommandCommand}" CommandParameter="Five" />
        <Button x:Name="ScientificSixButton" Grid.Row="5" Grid.Column="3" Classes="calcButton numeric" Content="6" Command="{Binding SendCommandCommand}" CommandParameter="Six" />
        <Button x:Name="ScientificSubtractButton" Grid.Row="5" Grid.Column="4" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xE949;" Command="{Binding SendCommandCommand}" CommandParameter="Subtract" />
        <Button x:Name="ScientificOneButton" Grid.Row="6" Grid.Column="1" Classes="calcButton numeric" Content="1" Command="{Binding SendCommandCommand}" CommandParameter="One" />
        <Button x:Name="ScientificTwoButton" Grid.Row="6" Grid.Column="2" Classes="calcButton numeric" Content="2" Command="{Binding SendCommandCommand}" CommandParameter="Two" />
        <Button x:Name="ScientificThreeButton" Grid.Row="6" Grid.Column="3" Classes="calcButton numeric" Content="3" Command="{Binding SendCommandCommand}" CommandParameter="Three" />
        <Button x:Name="ScientificAddButton" Grid.Row="6" Grid.Column="4" Classes="calcButton operator symbolOperator scientificErrorDisabled" Content="&#xE948;" Command="{Binding SendCommandCommand}" CommandParameter="Add" />
        <Button x:Name="ScientificSignButton" Grid.Row="7" Grid.Column="1" Classes="calcButton numeric symbolOperator scientificErrorDisabled" Content="&#xF898;" Command="{Binding SendCommandCommand}" CommandParameter="Sign" />
        <Button x:Name="ScientificZeroButton" Grid.Row="7" Grid.Column="2" Classes="calcButton numeric" Content="0" Command="{Binding SendCommandCommand}" CommandParameter="Zero" />
        <Button x:Name="ScientificDecimalButton" Grid.Row="7" Grid.Column="3" Classes="calcButton numeric" Content="{Binding DecimalSeparator}" Command="{Binding SendCommandCommand}" CommandParameter="Decimal" />
        <Button x:Name="ScientificEqualsButton" Grid.Row="7" Grid.Column="4" Classes="calcButton equalsButton" Content="&#xE94E;" Command="{Binding SendCommandCommand}" CommandParameter="Equals" />
      </Grid>

      <!-- Unit converter: the controls are backed by CalcViewModel's native
           UnitConverter and the original Microsoft conversion catalog. -->
      <Grid Grid.Row="1" Grid.RowSpan="5" Margin="12,2,12,12"
            RowDefinitions="Auto,1.12*,Auto,1.12*,Auto,1.65*"
            IsVisible="{Binding IsUnitConverterMode}">
        <ui:FAComboBox Grid.Row="0" Classes="unitSelector" Margin="0,0,0,7"
                       Padding="12,0,0,0"
                       VerticalContentAlignment="Center"
                       ItemsSource="{Binding UnitCategories}"
                       SelectedItem="{Binding SelectedUnitCategory}">
          <ui:FAComboBox.ItemTemplate>
            <DataTemplate x:DataType="managed:UnitConverterCategory">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ui:FAComboBox.ItemTemplate>
        </ui:FAComboBox>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="6,0">
          <TextBlock Classes="unitDisplay" Text="{Binding UnitFromDisplay}" />
          <ui:FAComboBox Grid.Row="1" Classes="unitSelector" Margin="0,2,0,4"
                         Padding="12,0,0,0"
                         VerticalContentAlignment="Center"
                         ItemsSource="{Binding UnitDefinitions}"
                         SelectedItem="{Binding SelectedFromUnit}">
            <ui:FAComboBox.ItemTemplate>
              <DataTemplate x:DataType="managed:UnitConverterUnit">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Margin="16,0,0,0" Opacity="0.65" Text="{Binding Abbreviation}" />
                </Grid>
              </DataTemplate>
            </ui:FAComboBox.ItemTemplate>
          </ui:FAComboBox>
        </Grid>

        <Button Grid.Row="2" Width="42" Height="34" Padding="0" HorizontalAlignment="Right"
                Margin="0,-1,6,-1" Background="Transparent" BorderThickness="0"
                FontSize="19" Content="⇅" AutomationProperties.Name="Swap units"
                Command="{Binding SwapUnitsCommand}" />

        <Grid Grid.Row="3" RowDefinitions="*,Auto" Margin="6,0">
          <TextBlock Classes="unitDisplay" Text="{Binding UnitToDisplay}" />
          <ui:FAComboBox Grid.Row="1" Classes="unitSelector" Margin="0,2,0,4"
                         Padding="12,0,0,0"
                         VerticalContentAlignment="Center"
                         ItemsSource="{Binding UnitDefinitions}"
                         SelectedItem="{Binding SelectedToUnit}">
            <ui:FAComboBox.ItemTemplate>
              <DataTemplate x:DataType="managed:UnitConverterUnit">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Margin="16,0,0,0" Opacity="0.65" Text="{Binding Abbreviation}" />
                </Grid>
              </DataTemplate>
            </ui:FAComboBox.ItemTemplate>
          </ui:FAComboBox>
        </Grid>

        <ItemsControl Grid.Row="4" Margin="6,5,6,8" ItemsSource="{Binding UnitSuggestions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,6,4" Padding="8,3" CornerRadius="4" Background="{DynamicResource CardBrush}">
                <TextBlock FontSize="13" Opacity="0.8" Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="5" Margin="-9,0,-9,-9" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*">
          <Button Classes="calcButton numeric" Content="7" Command="{Binding SendUnitCommandCommand}" CommandParameter="Seven" />
          <Button Grid.Column="1" Classes="calcButton numeric" Content="8" Command="{Binding SendUnitCommandCommand}" CommandParameter="Eight" />
          <Button Grid.Column="2" Classes="calcButton numeric" Content="9" Command="{Binding SendUnitCommandCommand}" CommandParameter="Nine" />

          <Button Grid.Row="1" Classes="calcButton numeric" Content="4" Command="{Binding SendUnitCommandCommand}" CommandParameter="Four" />
          <Button Grid.Row="1" Grid.Column="1" Classes="calcButton numeric" Content="5" Command="{Binding SendUnitCommandCommand}" CommandParameter="Five" />
          <Button Grid.Row="1" Grid.Column="2" Classes="calcButton numeric" Content="6" Command="{Binding SendUnitCommandCommand}" CommandParameter="Six" />

          <Button Grid.Row="2" Classes="calcButton numeric" Content="1" Command="{Binding SendUnitCommandCommand}" CommandParameter="One" />
          <Button Grid.Row="2" Grid.Column="1" Classes="calcButton numeric" Content="2" Command="{Binding SendUnitCommandCommand}" CommandParameter="Two" />
          <Button Grid.Row="2" Grid.Column="2" Classes="calcButton numeric" Content="3" Command="{Binding SendUnitCommandCommand}" CommandParameter="Three" />

          <Button Grid.Row="3" Classes="calcButton numeric symbolOperator" Content="&#xF898;" FontSize="23.1" Command="{Binding SendUnitCommandCommand}" CommandParameter="Negate" />
          <Button Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="0" Command="{Binding SendUnitCommandCommand}" CommandParameter="Zero" />
          <Grid Grid.Row="3" Grid.Column="2" ColumnDefinitions="*,*">
            <Button Classes="calcButton numeric" Content="{Binding DecimalSeparator}" FontSize="24.2" Command="{Binding SendUnitCommandCommand}" CommandParameter="Decimal" />
            <Button Grid.Column="1" Classes="calcButton operator symbolOperator" Content="&#xE94F;" FontSize="19.36" Command="{Binding SendUnitCommandCommand}" CommandParameter="Backspace" />
          </Grid>
        </Grid>
      </Grid>

      </local:NavigationCulledGrid>

      <controls:HistoryPane Grid.Column="1" IsDocked="True"
                            IsVisible="{Binding IsDockedHistoryPaneVisible}" />
      </Grid>

      <!-- Source NavigationView replacement. The pane overlays content in the
           original LeftMinimal mode and keeps the title bar unobstructed. -->
      <Grid Grid.Row="0" Grid.RowSpan="6" ColumnDefinitions="320,*"
            Classes="navigationOverlay" Classes.open="{Binding IsNavigationPaneOpen}">
        <Button Grid.ColumnSpan="2" Classes="navigationScrim" Padding="0" Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseNavigationPaneCommand}" />
        <Border Grid.Column="0" Classes="navigationPane" Background="{DynamicResource NavigationPaneBrush}"
                BorderBrush="{DynamicResource CalculatorBorderBrush}" BorderThickness="0,0,1,0"
                CornerRadius="0,8,8,0" ClipToBounds="True"
                BoxShadow="8 0 18 0 #50000000">
          <Border.Transitions>
            <Transitions>
              <ThicknessTransition Property="Margin" Duration="0:0:0.22">
                <ThicknessTransition.Easing>
                  <CubicEaseOut />
                </ThicknessTransition.Easing>
              </ThicknessTransition>
            </Transitions>
          </Border.Transitions>
          <Grid RowDefinitions="54,*,60">
            <Grid Grid.Row="0" ColumnDefinitions="56,*">
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,4,0,6">
                <TextBlock Margin="16,11,8,5" FontSize="19" FontWeight="Medium" Opacity="0.62"
                           Text="{Binding CalculatorGroupName}" />
                <ItemsControl ItemsSource="{Binding CalculatorNavigationItems}"
                              ItemTemplate="{StaticResource NavigationItemTemplate}" />

                <TextBlock Margin="16,18,8,5" FontSize="19" FontWeight="Medium" Opacity="0.62"
                           Text="{Binding ConverterGroupName}" />
                <ItemsControl ItemsSource="{Binding ConverterNavigationItems}"
                              ItemTemplate="{StaticResource NavigationItemTemplate}" />
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Height="1" Margin="0" VerticalAlignment="Top"
                    Background="{DynamicResource DividerBrush}" />
            <Button Grid.Row="2" Classes="navigationItem" Margin="4,16,8,4"
                    AutomationProperties.Name="{Binding SettingsName}"
                    Command="{Binding OpenSettingsCommand}">
              <Grid ColumnDefinitions="4,38,*">
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontFamily="{StaticResource CalculatorIconFont}" FontSize="18" Text="&#xE713;" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="14" Text="{Binding SettingsName}" />
              </Grid>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- NavigationView keeps one pane-toggle button above the translating
           pane. Its behavior changes to close while open, but its hamburger
           glyph remains stable. It is locked until the pane stops moving. -->
      <Button Grid.Row="0" Classes="chromeButton navigationToggle" Margin="5,9,5,3"
              AutomationProperties.Name="Switch calculator mode"
              IsVisible="{Binding !IsAlwaysOnTop}"
              IsHitTestVisible="{Binding CanInteractWithNavigationToggle}"
              Command="{Binding ToggleNavigationPaneCommand}">
        <Grid Width="24" Height="24">
          <Canvas Classes="hamburgerGlyph" Width="24" Height="24">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18" />
          </Canvas>
        </Grid>
      </Button>

      <!-- UWP uses Flyout Placement="Full" with BackgroundSmokeFill here.
           Keep this after the NavigationView toggle so the flyout owns the
           complete calculator page's visual and input layer. The sheet matches
           the keypad's height, which only the shell can measure. -->
      <controls:HistoryPane x:Name="NarrowHistory" Grid.Row="0" Grid.RowSpan="6" ZIndex="12"
                            IsDocked="False"
                            IsVisible="{Binding IsNarrowHistoryPaneVisible}"
                            SheetHeight="{Binding #CalculatorKeypadRegion.Bounds.Height}" />
      </Grid>

      <!-- Settings mirrors the source page's Appearance and About groups. -->
      <Grid Grid.Row="1" Grid.RowSpan="6" Background="Transparent"
            RowDefinitions="54,*" IsVisible="{Binding IsSettingsOpen}">
        <Grid.Resources>
          <!-- The outer Settings card owns its fill, border, and radius. Do not
               let Fluent draw a second inset ToggleButton surface inside it. -->
          <Thickness x:Key="ExpanderHeaderPadding">0</Thickness>
          <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="Transparent" />
          <Thickness x:Key="ExpanderContentPadding">0</Thickness>
          <Thickness x:Key="ExpanderContentLeftBorderThickness">0</Thickness>
          <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
          <Thickness x:Key="ExpanderContentRightBorderThickness">0</Thickness>
          <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrushDisabled" Color="Transparent" />
          <x:Double x:Key="ExpanderChevronButtonSize">0</x:Double>
          <Thickness x:Key="ExpanderChevronMargin">0</Thickness>
          <SolidColorBrush x:Key="ExpanderChevronForeground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronForegroundDisabled" Color="Transparent" />
        </Grid.Resources>
        <Grid Grid.Row="0" IsVisible="{Binding UsesWindowsWindowControls}">
          <TextBlock Classes="pageHeading" Margin="24,0,0,0" VerticalAlignment="Center"
                     Text="{Binding SettingsName}" />
        </Grid>
        <Grid Grid.Row="0" ColumnDefinitions="56,*" IsVisible="{Binding UsesMacOSWindowControls}">
          <Button Classes="chromeButton" Margin="5,3" FontSize="18"
                  AutomationProperties.Name="{Binding BackAutomationName}"
                  ToolTip.Tip="{Binding SettingsBackTooltip}"
                  Command="{Binding CloseSettingsCommand}">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.25"
                  Data="M 12.5,5.5 L 6,12 L 12.5,18.5 M 6,12 L 20,12" />
          </Button>
          <TextBlock Grid.Column="1" Classes="pageHeading" VerticalAlignment="Center"
                     Text="{Binding SettingsName}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionHeading" Margin="0,12,0,4"
                       Text="{Binding SettingsAppearanceName}" />

            <Border Classes="settingsCard" Background="Transparent"
                    CornerRadius="6" Padding="0" ClipToBounds="True">
              <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Height="72">
                    <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                          ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}" FontSize="20" Text="&#xE790;" />
                      <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="15" FontWeight="Normal" Text="{Binding AppThemeName}" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="13"
                                 Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                 Text="{Binding AppThemeDescription}" />
                      <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                            Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                            Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                            Data="M 1,1 L 6,6 L 11,1" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                            Background="{DynamicResource SettingsCardBorderBrush}"
                            IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Margin="68,14,16,14" Spacing="7">
                  <RadioButton GroupName="AppTheme" Content="{Binding LightThemeName}"
                               IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="Light" />
                  <RadioButton GroupName="AppTheme" Content="{Binding DarkThemeName}"
                               IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="Dark" />
                  <RadioButton GroupName="AppTheme" Content="{Binding SystemThemeName}"
                               IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="System" />
                </StackPanel>
              </local:AnimatedSettingsExpander>
            </Border>

            <Border Classes="settingsCard" Background="Transparent"
                    CornerRadius="6" Padding="0" ClipToBounds="True">
              <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Height="72">
                    <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                          ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                 FontSize="18" FontWeight="Normal" Text="Aa" />
                      <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="15" FontWeight="Normal"
                                 Text="{Binding AppFontName}" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="13"
                                 Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                 Text="{Binding AppFontDescription}" />
                      <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                            Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                            Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                            Data="M 1,1 L 6,6 L 11,1" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                            Background="{DynamicResource SettingsCardBorderBrush}"
                            IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                  </Grid>
                </Expander.Header>
                <ui:FAComboBox Margin="68,14,16,14"
                               HorizontalAlignment="Stretch"
                               Padding="12,0,0,0"
                               VerticalContentAlignment="Center"
                               MaxDropDownHeight="360"
                               ItemsSource="{Binding AvailableFontFamilies}"
                               SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}">
                  <ui:FAComboBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <!-- TODO: If a selected device font has unusual ascent or
                           descent metrics, calculate a runtime per-font baseline
                           adjustment instead of shifting every font globally. -->
                      <TextBlock VerticalAlignment="Center"
                                 FontFamily="{Binding}" Text="{Binding}" />
                    </DataTemplate>
                  </ui:FAComboBox.ItemTemplate>
                </ui:FAComboBox>
              </local:AnimatedSettingsExpander>
            </Border>

            <StackPanel IsVisible="{Binding SupportsPlatformAppearanceSettings}">
              <Border Classes="settingsCard" Background="{DynamicResource SettingsExpanderBrush}"
                      CornerRadius="6" Padding="24,18">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock FontSize="14" FontWeight="Normal" Text="{Binding MicaEffectName}" />
                  <TextBlock Grid.Row="1" Margin="0,2,16,0" FontSize="12"
                             Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                             Text="{Binding MicaEffectDescription}" TextWrapping="Wrap" />
                  <ToggleSwitch Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center"
                                IsChecked="{Binding UseMicaEffect}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard" Margin="0,4,0,0" Background="Transparent"
                      CornerRadius="6" Padding="0" ClipToBounds="True">
                <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent">
                  <Expander.Header>
                    <Grid Height="72">
                      <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                            ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="20" Text="⌜" />
                        <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="14" FontWeight="Normal" Text="{Binding WindowCornersName}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="12"
                                   Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                   Text="{Binding WindowCornersDescription}" />
                        <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                              Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                              Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                              Data="M 1,1 L 6,6 L 11,1" />
                      </Grid>
                      <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                              Background="{DynamicResource SettingsCardBorderBrush}"
                              IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="68,14,16,14" Spacing="7">
                    <RadioButton GroupName="WindowCorners" Content="{Binding Windows10CornersName}"
                                 IsChecked="{Binding IsWindows10CornerStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowCornerStyleCommand}" CommandParameter="Windows10" />
                    <RadioButton GroupName="WindowCorners" Content="{Binding Windows11CornersName}"
                                 IsChecked="{Binding IsWindows11CornerStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowCornerStyleCommand}" CommandParameter="Windows11" />
                    <RadioButton GroupName="WindowCorners" Content="{Binding MacOSCornersName}"
                                 IsChecked="{Binding IsMacOSCornerStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowCornerStyleCommand}" CommandParameter="MacOS" />
                  </StackPanel>
                </local:AnimatedSettingsExpander>
              </Border>

              <Border Classes="settingsCard" Margin="0,4,0,0" Background="Transparent"
                      CornerRadius="6" Padding="0" ClipToBounds="True">
                <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent">
                  <Expander.Header>
                    <Grid Height="72">
                      <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                            ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="18" Text="•••" />
                        <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="14" FontWeight="Normal" Text="{Binding WindowControlsName}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="12"
                                   Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                   Text="{Binding WindowControlsDescription}" />
                        <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                              Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                              Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                              Data="M 1,1 L 6,6 L 11,1" />
                      </Grid>
                      <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                              Background="{DynamicResource SettingsCardBorderBrush}"
                              IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="68,14,16,14" Spacing="7">
                    <RadioButton GroupName="WindowControls" Content="{Binding Windows10WindowControlsName}"
                                 IsChecked="{Binding IsWindows10WindowControlStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowControlStyleCommand}" CommandParameter="Windows10" />
                    <RadioButton GroupName="WindowControls" Content="{Binding Windows11WindowControlsName}"
                                 IsChecked="{Binding IsWindows11WindowControlStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowControlStyleCommand}" CommandParameter="Windows11" />
                    <RadioButton GroupName="WindowControls" Content="{Binding MacOSWindowControlsName}"
                                 IsChecked="{Binding IsMacOSWindowControlStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowControlStyleCommand}" CommandParameter="MacOS" />
                  </StackPanel>
                </local:AnimatedSettingsExpander>
              </Border>
            </StackPanel>

            <TextBlock Classes="sectionHeading" Margin="0,26,0,4"
                       Text="{Binding AboutGroupName}" />
            <Border Classes="settingsCard" Background="Transparent"
                    CornerRadius="6" Padding="0" ClipToBounds="True">
              <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Height="72">
                    <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center" ColumnDefinitions="36,*,32">
                      <Grid Width="24" Height="24">
                        <Border CornerRadius="3" Background="#6EC7E8" />
                        <Grid Margin="5" RowDefinitions="5,*" ColumnDefinitions="*,*" ColumnSpacing="2" RowSpacing="2">
                          <Border Grid.ColumnSpan="2" Background="#E9F7FC" />
                          <Border Grid.Row="1" Background="#315368" />
                          <Border Grid.Row="1" Grid.Column="1" Background="#315368" />
                        </Grid>
                      </Grid>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                 FontSize="14" Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                 Text="{Binding AboutVersionText}" />
                      <Path Grid.Column="2" Classes="settingsExpanderChevron"
                            Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                            Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                            Data="M 1,1 L 6,6 L 11,1" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                            Background="{DynamicResource SettingsCardBorderBrush}"
                            IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Margin="68,0,16,14" Spacing="12">
                  <Button Classes="settingsLink" Content="{Binding AboutLicenseName}" Click="License_OnClick" />
                  <Button Classes="settingsLink" Content="{Binding AboutServicesName}" Click="ServicesAgreement_OnClick" />
                  <Button Classes="settingsLink" Content="{Binding AboutPrivacyName}" Click="PrivacyStatement_OnClick" />
                </StackPanel>
              </local:AnimatedSettingsExpander>
            </Border>

            <Button Classes="settingsLink" Margin="0,10,0,0" Content="{Binding FeedbackName}" Click="Feedback_OnClick" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    </Border>

    <!-- Custom chrome removes the native frame, so retain native resizing through
         narrow hit targets at each edge and corner. -->
    <Grid RowDefinitions="7,*,7" ColumnDefinitions="7,*,7"
          IsVisible="{Binding UsesCustomResizeHandles}">
      <Border Grid.Row="0" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeNorthWest_OnPointerPressed" />
      <Border Grid.Row="0" Grid.Column="1" Background="Transparent"
              PointerPressed="ResizeNorth_OnPointerPressed" />
      <Border Grid.Row="0" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeNorthEast_OnPointerPressed" />
      <Border Grid.Row="1" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeWest_OnPointerPressed" />
      <Border Grid.Row="1" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeEast_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeSouthWest_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="1" Background="Transparent"
              PointerPressed="ResizeSouth_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeSouthEast_OnPointerPressed" />
    </Grid>
  </Grid>
</Window>
