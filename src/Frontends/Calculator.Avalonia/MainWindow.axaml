<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:managed="using:Calculator.Managed"
        x:Class="Calculator.Avalonia.MainWindow"
        x:DataType="managed:CalculatorViewModel"
        Width="524" Height="773"
        MinWidth="320" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#202027"
        Title="{Binding ApplicationName}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CalculatorBackgroundBrush" Color="#18383D40" />
          <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#202027" />
          <SolidColorBrush x:Key="CardBrush" Color="#303139" />
          <SolidColorBrush x:Key="NumericButtonBrush" Color="#383B3F" />
          <SolidColorBrush x:Key="NumericButtonHoverBrush" Color="#45484C" />
          <SolidColorBrush x:Key="NumericButtonPressedBrush" Color="#303236" />
          <SolidColorBrush x:Key="OperatorButtonBrush" Color="#303139" />
          <SolidColorBrush x:Key="OperatorButtonHoverBrush" Color="#3B3C45" />
          <SolidColorBrush x:Key="OperatorButtonPressedBrush" Color="#292A31" />
          <SolidColorBrush x:Key="ChromeHoverBrush" Color="#34343B" />
          <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#F5F5F5" />
          <SolidColorBrush x:Key="CalculatorBorderBrush" Color="#505158" />
          <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#303139" />
          <SolidColorBrush x:Key="DividerBrush" Color="#35FFFFFF" />
          <SolidColorBrush x:Key="AccentButtonBrush" Color="#4CC2FF" />
          <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#65CAFA" />
          <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#36A9E2" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CalculatorBackgroundBrush" Color="#18F3F3F3" />
          <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="CardBrush" Color="#FBFBFB" />
          <SolidColorBrush x:Key="NumericButtonBrush" Color="#FCFCFC" />
          <SolidColorBrush x:Key="NumericButtonHoverBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NumericButtonPressedBrush" Color="#F4F4F4" />
          <SolidColorBrush x:Key="OperatorButtonBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="OperatorButtonHoverBrush" Color="#F8F8F8" />
          <SolidColorBrush x:Key="OperatorButtonPressedBrush" Color="#EAEAEA" />
          <SolidColorBrush x:Key="ChromeHoverBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="CalculatorBorderBrush" Color="#D0D0D0" />
          <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#E7E7E7" />
          <SolidColorBrush x:Key="DividerBrush" Color="#18000000" />
          <SolidColorBrush x:Key="AccentButtonBrush" Color="#0067C0" />
          <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#1975C5" />
          <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#005A9E" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    <FontFamily x:Key="CalculatorIconFont">avares://Redmond%20Calculator/Assets/CalculatorIcons.ttf#Calculator Fluent Icons</FontFamily>
    <DataTemplate x:Key="NavigationItemTemplate" x:DataType="managed:CalculatorNavigationItem" x:CompileBindings="False">
      <Button Classes="navigationItem"
              Classes.selected="{Binding IsSelected}"
              IsEnabled="{Binding IsEnabled}"
              AutomationProperties.Name="{Binding Name}"
              Command="{Binding $parent[Window].DataContext.SelectNavigationItemCommand}"
              CommandParameter="{Binding}">
        <Grid ColumnDefinitions="4,38,*">
          <Border Width="3" Height="18" CornerRadius="2" VerticalAlignment="Center"
                  Background="{DynamicResource AccentButtonBrush}"
                  IsVisible="{Binding IsSelected}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                     FontFamily="{StaticResource CalculatorIconFont}" FontSize="18" Text="{Binding Glyph}" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                     FontSize="14" Text="{Binding Name}" />
        </Grid>
      </Button>
    </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.titleButton">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.titleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
    </Style>
    <Style Selector="Button.titleButton.close:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chromeButton">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="Button.chromeButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
    </Style>
    <Style Selector="Button.navigationToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Grid.navigationOverlay">
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Grid.navigationOverlay.open">
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.navigationScrim">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Border.navigationPane">
      <Setter Property="Margin" Value="-320,0,320,0" />
    </Style>
    <Style Selector="Grid.navigationOverlay.open Border.navigationPane">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.navigationItem">
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="4,1,8,1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.navigationItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.navigationItem.selected">
      <Setter Property="Background" Value="{DynamicResource NavigationSelectedBrush}" />
    </Style>
    <Style Selector="Button.navigationItem:disabled">
      <Setter Property="Opacity" Value="0.38" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.settingsLink">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.memoryButton">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.memoryButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
    </Style>
    <Style Selector="Button.memoryButton:disabled">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.calcButton">
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.calcButton.numeric">
      <Setter Property="Background" Value="{DynamicResource NumericButtonBrush}" />
      <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="Button.calcButton.numeric:pointerover">
      <Setter Property="Background" Value="{DynamicResource NumericButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.calcButton.numeric:pressed">
      <Setter Property="Background" Value="{DynamicResource NumericButtonPressedBrush}" />
    </Style>
    <Style Selector="Button.calcButton.operator">
      <Setter Property="Background" Value="{DynamicResource OperatorButtonBrush}" />
    </Style>
    <Style Selector="Button.calcButton.operator:pointerover">
      <Setter Property="Background" Value="{DynamicResource OperatorButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.calcButton.operator:pressed">
      <Setter Property="Background" Value="{DynamicResource OperatorButtonPressedBrush}" />
    </Style>
    <Style Selector="Button.calcButton.equalsButton">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBrush}" />
      <Setter Property="Foreground" Value="#101010" />
      <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="Button.calcButton.equalsButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.calcButton.equalsButton:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentButtonPressedBrush}" />
    </Style>
    <Style Selector="ComboBox.unitSelector">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CalculatorBorderBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.unitDisplay">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid>
    <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource CalculatorBackgroundBrush}"
            BorderBrush="{DynamicResource CalculatorBorderBrush}" BorderThickness="1">
    <Grid RowDefinitions="42,54,*,42,3.05*">
      <!-- Source-faithful replacement for CalculatorApp.TitleBar. -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="Transparent"
            PointerPressed="TitleBar_OnPointerPressed">
        <Grid Width="22" Height="22" Margin="18,10,12,10">
          <Border CornerRadius="2" Background="#6EC7E8" />
          <Grid Margin="5" RowDefinitions="5,*" ColumnDefinitions="*,*" ColumnSpacing="2" RowSpacing="2">
            <Border Grid.ColumnSpan="2" Background="#E9F7FC" />
            <Border Grid.Row="1" Background="#315368" />
            <Border Grid.Row="1" Grid.Column="1" Background="#315368" />
          </Grid>
        </Grid>
        <Button Grid.Column="2" Classes="titleButton" AutomationProperties.Name="Minimize" Click="Minimize_OnClick">
          <Border Width="10" Height="1" Background="{DynamicResource ChromeForegroundBrush}" />
        </Button>
        <Button Grid.Column="3" Classes="titleButton" AutomationProperties.Name="Maximize" Click="Maximize_OnClick">
          <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1" Data="M 1.5,1.5 L 10.5,1.5 L 10.5,10.5 L 1.5,10.5 Z" />
        </Button>
        <Button Grid.Column="4" Classes="titleButton close" AutomationProperties.Name="Close" Click="Close_OnClick">
          <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1" Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" />
        </Button>
      </Grid>

      <!-- Hamburger/category/history row from MainPage + Calculator. -->
      <Grid Grid.Row="1" ColumnDefinitions="56,Auto,62,*,56">
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{Binding ModeDisplayName}" />
        <Button Grid.Column="2" Classes="chromeButton" Margin="10,3,0,3" AutomationProperties.Name="Compact overlay">
          <Canvas Width="24" Height="24">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.4"
                  Data="M 7,4 L 20,4 L 20,17 L 16,17 M 4,8 L 16,8 L 16,20 L 4,20 Z M 4,14 L 10,8 M 4,9 L 4,14 L 9,14" />
          </Canvas>
        </Button>
        <Button Grid.Column="4" Classes="chromeButton" AutomationProperties.Name="{Binding HistoryAutomationName}">
          <Canvas Width="28" Height="28">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 6,9 A 9,9 0 1 1 5,16 M 3,6 L 3,12 L 9,12 M 14,8 L 14,14 L 18,16" />
          </Canvas>
        </Button>
      </Grid>

      <!-- The original uses proportional Expression and Result rows. -->
      <Grid Grid.Row="2" Margin="8,0,14,0" IsVisible="{Binding IsStandardMode}">
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,8,0,0" Opacity="0.64" FontSize="14" Text="{Binding ExpressionDisplay}" />
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,24"
                   FontSize="48" FontWeight="SemiBold" Text="{Binding PrimaryDisplay}" />
      </Grid>

      <!-- MemoryPanel: MC, MR, M+, M−, MS, memory flyout. -->
      <Grid Grid.Row="3" Margin="3,0" ColumnDefinitions="*,*,*,*,*,*" IsVisible="{Binding IsStandardMode}">
        <Button Classes="memoryButton" Content="MC" IsEnabled="{Binding HasMemory}" Command="{Binding MemoryClearAllCommand}" />
        <Button Grid.Column="1" Classes="memoryButton" Content="MR" IsEnabled="{Binding HasMemory}" Command="{Binding MemoryRecallCommand}" />
        <Button Grid.Column="2" Classes="memoryButton" Content="M+" Command="{Binding MemoryAddCommand}" />
        <Button Grid.Column="3" Classes="memoryButton" Content="M−" Command="{Binding MemorySubtractCommand}" />
        <Button Grid.Column="4" Classes="memoryButton" Content="MS" Command="{Binding MemoryStoreCommand}" />
        <Button Grid.Column="5" Classes="memoryButton" Content="M⌄" IsEnabled="False" />
      </Grid>

      <!-- CalculatorStandardOperators + NumberPad, flattened without changing geometry. -->
      <Grid Grid.Row="4" Margin="3,0,3,3"
            RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="*,*,*,*"
            IsVisible="{Binding IsStandardMode}">
        <Button Classes="calcButton operator" Content="%" Command="{Binding SendCommandCommand}" CommandParameter="Percent" />
        <Button Grid.Column="1" Classes="calcButton operator" Content="CE" FontSize="16" Command="{Binding SendCommandCommand}" CommandParameter="ClearEntry" />
        <Button Grid.Column="2" Classes="calcButton operator" Content="C" FontSize="16" Command="{Binding SendCommandCommand}" CommandParameter="Clear" />
        <Button Grid.Column="3" Classes="calcButton operator" Content="⌫" FontSize="18" Command="{Binding SendCommandCommand}" CommandParameter="Backspace" />

        <Button Grid.Row="1" Classes="calcButton operator" FontFamily="Times New Roman" FontStyle="Italic" Content="⅟x" Command="{Binding SendCommandCommand}" CommandParameter="Reciprocal" />
        <Button Grid.Row="1" Grid.Column="1" Classes="calcButton operator" FontFamily="Times New Roman" FontStyle="Italic" Content="x²" Command="{Binding SendCommandCommand}" CommandParameter="Square" />
        <Button Grid.Row="1" Grid.Column="2" Classes="calcButton operator" FontFamily="Times New Roman" Content="²√x" Command="{Binding SendCommandCommand}" CommandParameter="SquareRoot" />
        <Button Grid.Row="1" Grid.Column="3" Classes="calcButton operator" Content="÷" FontSize="25" Command="{Binding SendCommandCommand}" CommandParameter="Divide" />

        <Button Grid.Row="2" Classes="calcButton numeric" Content="7" Command="{Binding SendCommandCommand}" CommandParameter="Seven" />
        <Button Grid.Row="2" Grid.Column="1" Classes="calcButton numeric" Content="8" Command="{Binding SendCommandCommand}" CommandParameter="Eight" />
        <Button Grid.Row="2" Grid.Column="2" Classes="calcButton numeric" Content="9" Command="{Binding SendCommandCommand}" CommandParameter="Nine" />
        <Button Grid.Row="2" Grid.Column="3" Classes="calcButton operator" Content="×" FontSize="25" Command="{Binding SendCommandCommand}" CommandParameter="Multiply" />

        <Button Grid.Row="3" Classes="calcButton numeric" Content="4" Command="{Binding SendCommandCommand}" CommandParameter="Four" />
        <Button Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="5" Command="{Binding SendCommandCommand}" CommandParameter="Five" />
        <Button Grid.Row="3" Grid.Column="2" Classes="calcButton numeric" Content="6" Command="{Binding SendCommandCommand}" CommandParameter="Six" />
        <Button Grid.Row="3" Grid.Column="3" Classes="calcButton operator" Content="−" FontSize="25" Command="{Binding SendCommandCommand}" CommandParameter="Subtract" />

        <Button Grid.Row="4" Classes="calcButton numeric" Content="1" Command="{Binding SendCommandCommand}" CommandParameter="One" />
        <Button Grid.Row="4" Grid.Column="1" Classes="calcButton numeric" Content="2" Command="{Binding SendCommandCommand}" CommandParameter="Two" />
        <Button Grid.Row="4" Grid.Column="2" Classes="calcButton numeric" Content="3" Command="{Binding SendCommandCommand}" CommandParameter="Three" />
        <Button Grid.Row="4" Grid.Column="3" Classes="calcButton operator" Content="+" FontSize="25" Command="{Binding SendCommandCommand}" CommandParameter="Add" />

        <Button Grid.Row="5" Classes="calcButton numeric" Content="⁺/₋" FontSize="21" Command="{Binding SendCommandCommand}" CommandParameter="Sign" />
        <Button Grid.Row="5" Grid.Column="1" Classes="calcButton numeric" Content="0" Command="{Binding SendCommandCommand}" CommandParameter="Zero" />
        <Button Grid.Row="5" Grid.Column="2" Classes="calcButton numeric" Content="." Command="{Binding SendCommandCommand}" CommandParameter="Decimal" />
        <Button Grid.Row="5" Grid.Column="3" Classes="calcButton equalsButton" Content="=" Command="{Binding SendCommandCommand}" CommandParameter="Equals" />
      </Grid>

      <!-- Unit converter: the controls are backed by CalcViewModel's native
           UnitConverter and the original Microsoft conversion catalog. -->
      <Grid Grid.Row="2" Grid.RowSpan="3" Margin="12,2,12,12"
            RowDefinitions="Auto,1.12*,Auto,1.12*,Auto,1.65*"
            IsVisible="{Binding IsUnitConverterMode}">
        <ComboBox Grid.Row="0" Classes="unitSelector" Margin="0,0,0,7"
                  ItemsSource="{Binding UnitCategories}"
                  SelectedItem="{Binding SelectedUnitCategory}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="managed:UnitConverterCategory">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="6,0">
          <TextBlock Classes="unitDisplay" Text="{Binding UnitFromDisplay}" />
          <ComboBox Grid.Row="1" Classes="unitSelector" Margin="0,2,0,4"
                    ItemsSource="{Binding UnitDefinitions}"
                    SelectedItem="{Binding SelectedFromUnit}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="managed:UnitConverterUnit">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Margin="16,0,0,0" Opacity="0.65" Text="{Binding Abbreviation}" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Button Grid.Row="2" Width="42" Height="34" Padding="0" HorizontalAlignment="Right"
                Margin="0,-1,6,-1" Background="Transparent" BorderThickness="0"
                FontSize="19" Content="⇅" AutomationProperties.Name="Swap units"
                Command="{Binding SwapUnitsCommand}" />

        <Grid Grid.Row="3" RowDefinitions="*,Auto" Margin="6,0">
          <TextBlock Classes="unitDisplay" Text="{Binding UnitToDisplay}" />
          <ComboBox Grid.Row="1" Classes="unitSelector" Margin="0,2,0,4"
                    ItemsSource="{Binding UnitDefinitions}"
                    SelectedItem="{Binding SelectedToUnit}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="managed:UnitConverterUnit">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Margin="16,0,0,0" Opacity="0.65" Text="{Binding Abbreviation}" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <ItemsControl Grid.Row="4" Margin="6,5,6,8" ItemsSource="{Binding UnitSuggestions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,6,4" Padding="8,3" CornerRadius="4" Background="{DynamicResource CardBrush}">
                <TextBlock FontSize="13" Opacity="0.8" Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="5" Margin="-9,0,-9,-9" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*">
          <Button Classes="calcButton numeric" Content="7" Command="{Binding SendUnitCommandCommand}" CommandParameter="Seven" />
          <Button Grid.Column="1" Classes="calcButton numeric" Content="8" Command="{Binding SendUnitCommandCommand}" CommandParameter="Eight" />
          <Button Grid.Column="2" Classes="calcButton numeric" Content="9" Command="{Binding SendUnitCommandCommand}" CommandParameter="Nine" />

          <Button Grid.Row="1" Classes="calcButton numeric" Content="4" Command="{Binding SendUnitCommandCommand}" CommandParameter="Four" />
          <Button Grid.Row="1" Grid.Column="1" Classes="calcButton numeric" Content="5" Command="{Binding SendUnitCommandCommand}" CommandParameter="Five" />
          <Button Grid.Row="1" Grid.Column="2" Classes="calcButton numeric" Content="6" Command="{Binding SendUnitCommandCommand}" CommandParameter="Six" />

          <Button Grid.Row="2" Classes="calcButton numeric" Content="1" Command="{Binding SendUnitCommandCommand}" CommandParameter="One" />
          <Button Grid.Row="2" Grid.Column="1" Classes="calcButton numeric" Content="2" Command="{Binding SendUnitCommandCommand}" CommandParameter="Two" />
          <Button Grid.Row="2" Grid.Column="2" Classes="calcButton numeric" Content="3" Command="{Binding SendUnitCommandCommand}" CommandParameter="Three" />

          <Button Grid.Row="3" Classes="calcButton operator" Content="⁺/₋" FontSize="21" Command="{Binding SendUnitCommandCommand}" CommandParameter="Negate" />
          <Button Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="0" Command="{Binding SendUnitCommandCommand}" CommandParameter="Zero" />
          <Grid Grid.Row="3" Grid.Column="2" ColumnDefinitions="*,*">
            <Button Classes="calcButton operator" Content="." FontSize="22" Command="{Binding SendUnitCommandCommand}" CommandParameter="Decimal" />
            <Button Grid.Column="1" Classes="calcButton operator" Content="⌫" FontSize="18" Command="{Binding SendUnitCommandCommand}" CommandParameter="Backspace" />
          </Grid>
        </Grid>
      </Grid>

      <!-- Source NavigationView replacement. The pane overlays content in the
           original LeftMinimal mode and keeps the title bar unobstructed. -->
      <Grid Grid.Row="1" Grid.RowSpan="4" ColumnDefinitions="320,*"
            Classes="navigationOverlay" Classes.open="{Binding IsNavigationPaneOpen}">
        <Button Grid.ColumnSpan="2" Classes="navigationScrim" Padding="0" Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseNavigationPaneCommand}" />
        <Border Grid.Column="0" Classes="navigationPane" Background="{DynamicResource SolidSurfaceBrush}"
                BorderBrush="{DynamicResource CalculatorBorderBrush}" BorderThickness="0,0,1,0"
                CornerRadius="0,8,8,0" ClipToBounds="True"
                BoxShadow="8 0 18 0 #50000000">
          <Border.Transitions>
            <Transitions>
              <ThicknessTransition Property="Margin" Duration="0:0:0.22">
                <ThicknessTransition.Easing>
                  <CubicEaseOut />
                </ThicknessTransition.Easing>
              </ThicknessTransition>
            </Transitions>
          </Border.Transitions>
          <Grid RowDefinitions="54,*,48">
            <Grid Grid.Row="0" ColumnDefinitions="56,*">
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,4,0,12">
                <TextBlock Margin="16,8,8,5" FontSize="12" FontWeight="SemiBold" Opacity="0.62"
                           Text="{Binding CalculatorGroupName}" />
                <ItemsControl ItemsSource="{Binding CalculatorNavigationItems}"
                              ItemTemplate="{StaticResource NavigationItemTemplate}" />

                <TextBlock Margin="16,18,8,5" FontSize="12" FontWeight="SemiBold" Opacity="0.62"
                           Text="{Binding ConverterGroupName}" />
                <ItemsControl ItemsSource="{Binding ConverterNavigationItems}"
                              ItemTemplate="{StaticResource NavigationItemTemplate}" />
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Height="1" Margin="8,0,8,0" VerticalAlignment="Top"
                    Background="{DynamicResource DividerBrush}" />
            <Button Grid.Row="2" Classes="navigationItem" Margin="4,4,8,4"
                    AutomationProperties.Name="{Binding SettingsName}"
                    Command="{Binding OpenSettingsCommand}">
              <Grid ColumnDefinitions="4,38,*">
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontFamily="{StaticResource CalculatorIconFont}" FontSize="18" Text="&#xE713;" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="14" Text="{Binding SettingsName}" />
              </Grid>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- NavigationView keeps one pane-toggle button above the translating
           pane. Its behavior changes to close while open, but its hamburger
           glyph remains stable. It is locked until the pane stops moving. -->
      <Button Grid.Row="1" Classes="chromeButton navigationToggle" Margin="5,3"
              AutomationProperties.Name="Switch calculator mode"
              IsVisible="{Binding !IsSettingsOpen}"
              IsHitTestVisible="{Binding CanInteractWithNavigationToggle}"
              Command="{Binding ToggleNavigationPaneCommand}">
        <Grid Width="24" Height="24">
          <Canvas Width="24" Height="24">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18" />
          </Canvas>
        </Grid>
      </Button>

      <!-- Settings mirrors the source page's Appearance and About groups. -->
      <Grid Grid.Row="1" Grid.RowSpan="4" Background="{DynamicResource SolidSurfaceBrush}"
            RowDefinitions="54,*" IsVisible="{Binding IsSettingsOpen}">
        <Grid Grid.Row="0" ColumnDefinitions="56,*">
          <Button Classes="chromeButton" Margin="5,3" FontSize="18"
                  AutomationProperties.Name="{Binding BackAutomationName}"
                  Command="{Binding CloseSettingsCommand}">
            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 18,4 L 8,12 L 18,20 M 8,12 L 22,12" />
          </Button>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold"
                     Text="{Binding SettingsName}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <TextBlock Margin="0,12,0,4" FontSize="14" FontWeight="SemiBold"
                       Text="{Binding SettingsAppearanceName}" />

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CalculatorBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="0">
              <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Margin="12,8" ColumnDefinitions="36,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontFamily="{StaticResource CalculatorIconFont}" FontSize="20" Text="&#xE790;" />
                    <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Text="{Binding AppThemeName}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" FontSize="13" Opacity="0.65"
                               Text="{Binding AppThemeDescription}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Margin="50,0,16,14" Spacing="7">
                  <RadioButton GroupName="AppTheme" Content="{Binding LightThemeName}"
                               IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="Light" />
                  <RadioButton GroupName="AppTheme" Content="{Binding DarkThemeName}"
                               IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="Dark" />
                  <RadioButton GroupName="AppTheme" Content="{Binding SystemThemeName}"
                               IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="System" />
                </StackPanel>
              </Expander>
            </Border>

            <TextBlock Margin="0,26,0,4" FontSize="14" FontWeight="SemiBold"
                       Text="{Binding AboutGroupName}" />
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CalculatorBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="0">
              <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Margin="12,8" ColumnDefinitions="36,*">
                    <Grid Width="24" Height="24">
                      <Border CornerRadius="3" Background="#6EC7E8" />
                      <Grid Margin="5" RowDefinitions="5,*" ColumnDefinitions="*,*" ColumnSpacing="2" RowSpacing="2">
                        <Border Grid.ColumnSpan="2" Background="#E9F7FC" />
                        <Border Grid.Row="1" Background="#315368" />
                        <Border Grid.Row="1" Grid.Column="1" Background="#315368" />
                      </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontSize="14" Opacity="0.68" Text="{Binding AboutVersionText}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Margin="50,0,16,14" Spacing="12">
                  <Button Classes="settingsLink" Content="{Binding AboutLicenseName}" Click="License_OnClick" />
                  <Button Classes="settingsLink" Content="{Binding AboutServicesName}" Click="ServicesAgreement_OnClick" />
                  <Button Classes="settingsLink" Content="{Binding AboutPrivacyName}" Click="PrivacyStatement_OnClick" />
                </StackPanel>
              </Expander>
            </Border>

            <Button Classes="settingsLink" Margin="0,10,0,0" Content="{Binding FeedbackName}" Click="Feedback_OnClick" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    </Border>

    <!-- Custom chrome removes the native frame, so retain native resizing through
         narrow hit targets at each edge and corner. -->
    <Grid RowDefinitions="7,*,7" ColumnDefinitions="7,*,7">
      <Border Grid.Row="0" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeNorthWest_OnPointerPressed" />
      <Border Grid.Row="0" Grid.Column="1" Background="Transparent"
              PointerPressed="ResizeNorth_OnPointerPressed" />
      <Border Grid.Row="0" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeNorthEast_OnPointerPressed" />
      <Border Grid.Row="1" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeWest_OnPointerPressed" />
      <Border Grid.Row="1" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeEast_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeSouthWest_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="1" Background="Transparent"
              PointerPressed="ResizeSouth_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeSouthEast_OnPointerPressed" />
    </Grid>
  </Grid>
</Window>
