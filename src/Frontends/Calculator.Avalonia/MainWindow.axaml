<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Calculator.Avalonia"
        xmlns:managed="using:Calculator.Managed"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:shell="using:Calculator.Avalonia.Shell"
        xmlns:controls="using:Calculator.Avalonia.Controls"
        xmlns:views="using:Calculator.Avalonia.Views"
        x:Class="Calculator.Avalonia.MainWindow"
        x:DataType="managed:CalculatorViewModel"
        Width="524" Height="773"
        MinWidth="320" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#202027"
        Title="{Binding ApplicationName}">

  <Grid>
    <Border Classes="windowSurface"
            Classes.noBackdrop="{Binding !UseMicaEffect}"
            Classes.inactive="{Binding !IsActive, RelativeSource={RelativeSource AncestorType=Window}}"
            Classes.nativeFrame="{Binding UsesNativeWindowGeometry}"
            Classes.squareCorners="{Binding UsesSquareWindowCorners}"
            ClipToBounds="True"
            BorderBrush="{DynamicResource CalculatorBorderBrush}">
    <Border.Transitions>
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25">
          <BrushTransition.Easing>
            <SplineEasing X1="0.55" Y1="0.55" X2="0" Y2="1" />
          </BrushTransition.Easing>
        </BrushTransition>
      </Transitions>
    </Border.Transitions>
    <Grid RowDefinitions="Auto,48,22*,72*,0,32*,308*">
      <shell:WindowChrome Grid.Row="0" x:Name="TitleBarChrome" />

      <!-- Calculator and Settings are separate page surfaces beneath the
           shared title bar. Keep the inactive page out of layout and hit
           testing instead of covering it with a transparent overlay. -->
      <Grid Grid.Row="1" Grid.RowSpan="6" RowDefinitions="48,22*,72*,0,32*,308*"
            IsVisible="{Binding !IsSettingsOpen}">
      <Grid x:Name="CalculatorResponsiveLayout" Grid.RowSpan="6" ColumnDefinitions="*,0">
      <local:NavigationCulledGrid x:Name="CalculatorPageContent" Grid.RowSpan="6"
                                 Classes="calculatorPageContent"
                                 Classes.paneOpen="{Binding IsNavigationPaneOpen}">
      <local:NavigationCulledGrid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="22*" MinHeight="0" />
        <RowDefinition Height="72*" MinHeight="20" />
        <RowDefinition Height="0" />
        <RowDefinition Height="32*" MinHeight="0" />
        <RowDefinition Height="308*" MinHeight="0" />
      </local:NavigationCulledGrid.RowDefinitions>
      <!-- Hamburger/category/history row from MainPage + Calculator. -->
      <Grid Grid.Row="0" ColumnDefinitions="68,Auto,62,*,56">
        <TextBlock Grid.Column="1" Classes="pageHeading" VerticalAlignment="Center" Text="{Binding ModeDisplayName}" />
        <Button Grid.Column="2" Classes="chromeButton" Margin="10,3,0,3"
                AutomationProperties.Name="{Binding AlwaysOnTopAutomationName}"
                IsVisible="{Binding CanEnterAlwaysOnTop}"
                ToolTip.Placement="Bottom"
                Click="AlwaysOnTop_OnClick">
          <ToolTip.Tip>
            <TextBlock Text="{Binding AlwaysOnTopTooltip}" />
          </ToolTip.Tip>
          <TextBlock Classes="alwaysOnTopGlyph" Text="{Binding AlwaysOnTopGlyph}" />
        </Button>
        <Button x:Name="HistoryButton" Grid.Column="4" Classes="chromeButton"
                AutomationProperties.Name="{Binding HistoryAutomationName}"
                IsVisible="{Binding IsHistoryButtonVisible}"
                Command="{Binding ToggleHistoryCommand}" ToolTip.Tip="{Binding HistoryTooltip}">
          <Canvas Width="28" Height="28">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 6,9 A 9,9 0 1 1 5,16 M 3,6 L 3,12 L 9,12 M 14,8 L 14,14 L 18,16" />
          </Canvas>
        </Button>
      </Grid>

      <controls:CalculatorDisplay Grid.Row="1" Grid.RowSpan="2" x:Name="Display" />

      <views:ScientificDisplayControls x:Name="ScientificControls" Grid.Row="3" />

      <controls:MemoryPanel Grid.Row="4" x:Name="MemoryRow" />


      <views:ProgrammerCalculatorView x:Name="ProgrammerView" Grid.Row="3" Grid.RowSpan="3" />

      <!-- CalculatorStandardOperators + NumberPad, flattened without changing geometry. -->
      <Grid x:Name="CalculatorKeypadRegion" Grid.Row="5" IsHitTestVisible="False" />
      <views:StandardCalculatorView x:Name="StandardView" Grid.Row="5" />

      <views:ScientificCalculatorView x:Name="ScientificView" Grid.Row="5" />

      <!-- Unit converter: the controls are backed by CalcViewModel's native
           UnitConverter and the original Microsoft conversion catalog. -->
      <Grid Grid.Row="1" Grid.RowSpan="5" Margin="12,2,12,12"
            RowDefinitions="Auto,1.12*,Auto,1.12*,Auto,1.65*"
            IsVisible="{Binding IsUnitConverterMode}">
        <ui:FAComboBox Grid.Row="0" Classes="unitSelector" Margin="0,0,0,7"
                       Padding="12,0,0,0"
                       VerticalContentAlignment="Center"
                       ItemsSource="{Binding UnitCategories}"
                       SelectedItem="{Binding SelectedUnitCategory}">
          <ui:FAComboBox.ItemTemplate>
            <DataTemplate x:DataType="managed:UnitConverterCategory">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ui:FAComboBox.ItemTemplate>
        </ui:FAComboBox>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="6,0">
          <TextBlock Classes="unitDisplay" Text="{Binding UnitFromDisplay}" />
          <ui:FAComboBox Grid.Row="1" Classes="unitSelector" Margin="0,2,0,4"
                         Padding="12,0,0,0"
                         VerticalContentAlignment="Center"
                         ItemsSource="{Binding UnitDefinitions}"
                         SelectedItem="{Binding SelectedFromUnit}">
            <ui:FAComboBox.ItemTemplate>
              <DataTemplate x:DataType="managed:UnitConverterUnit">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Margin="16,0,0,0" Opacity="0.65" Text="{Binding Abbreviation}" />
                </Grid>
              </DataTemplate>
            </ui:FAComboBox.ItemTemplate>
          </ui:FAComboBox>
        </Grid>

        <Button Grid.Row="2" Width="42" Height="34" Padding="0" HorizontalAlignment="Right"
                Margin="0,-1,6,-1" Background="Transparent" BorderThickness="0"
                FontSize="19" Content="⇅" AutomationProperties.Name="Swap units"
                Command="{Binding SwapUnitsCommand}" />

        <Grid Grid.Row="3" RowDefinitions="*,Auto" Margin="6,0">
          <TextBlock Classes="unitDisplay" Text="{Binding UnitToDisplay}" />
          <ui:FAComboBox Grid.Row="1" Classes="unitSelector" Margin="0,2,0,4"
                         Padding="12,0,0,0"
                         VerticalContentAlignment="Center"
                         ItemsSource="{Binding UnitDefinitions}"
                         SelectedItem="{Binding SelectedToUnit}">
            <ui:FAComboBox.ItemTemplate>
              <DataTemplate x:DataType="managed:UnitConverterUnit">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Margin="16,0,0,0" Opacity="0.65" Text="{Binding Abbreviation}" />
                </Grid>
              </DataTemplate>
            </ui:FAComboBox.ItemTemplate>
          </ui:FAComboBox>
        </Grid>

        <ItemsControl Grid.Row="4" Margin="6,5,6,8" ItemsSource="{Binding UnitSuggestions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,6,4" Padding="8,3" CornerRadius="4" Background="{DynamicResource CardBrush}">
                <TextBlock FontSize="13" Opacity="0.8" Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="5" Margin="-9,0,-9,-9" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*">
          <Button Classes="calcButton numeric" Content="7" Command="{Binding SendUnitCommandCommand}" CommandParameter="Seven" />
          <Button Grid.Column="1" Classes="calcButton numeric" Content="8" Command="{Binding SendUnitCommandCommand}" CommandParameter="Eight" />
          <Button Grid.Column="2" Classes="calcButton numeric" Content="9" Command="{Binding SendUnitCommandCommand}" CommandParameter="Nine" />

          <Button Grid.Row="1" Classes="calcButton numeric" Content="4" Command="{Binding SendUnitCommandCommand}" CommandParameter="Four" />
          <Button Grid.Row="1" Grid.Column="1" Classes="calcButton numeric" Content="5" Command="{Binding SendUnitCommandCommand}" CommandParameter="Five" />
          <Button Grid.Row="1" Grid.Column="2" Classes="calcButton numeric" Content="6" Command="{Binding SendUnitCommandCommand}" CommandParameter="Six" />

          <Button Grid.Row="2" Classes="calcButton numeric" Content="1" Command="{Binding SendUnitCommandCommand}" CommandParameter="One" />
          <Button Grid.Row="2" Grid.Column="1" Classes="calcButton numeric" Content="2" Command="{Binding SendUnitCommandCommand}" CommandParameter="Two" />
          <Button Grid.Row="2" Grid.Column="2" Classes="calcButton numeric" Content="3" Command="{Binding SendUnitCommandCommand}" CommandParameter="Three" />

          <Button Grid.Row="3" Classes="calcButton numeric symbolOperator" Content="&#xF898;" FontSize="23.1" Command="{Binding SendUnitCommandCommand}" CommandParameter="Negate" />
          <Button Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="0" Command="{Binding SendUnitCommandCommand}" CommandParameter="Zero" />
          <Grid Grid.Row="3" Grid.Column="2" ColumnDefinitions="*,*">
            <Button Classes="calcButton numeric" Content="{Binding DecimalSeparator}" FontSize="24.2" Command="{Binding SendUnitCommandCommand}" CommandParameter="Decimal" />
            <Button Grid.Column="1" Classes="calcButton operator symbolOperator" Content="&#xE94F;" FontSize="19.36" Command="{Binding SendUnitCommandCommand}" CommandParameter="Backspace" />
          </Grid>
        </Grid>
      </Grid>

      </local:NavigationCulledGrid>

      <controls:HistoryPane Grid.Column="1" IsDocked="True"
                            IsVisible="{Binding IsDockedHistoryPaneVisible}" />
      </Grid>

      <!-- Source NavigationView replacement. The pane overlays content in the
           original LeftMinimal mode and keeps the title bar unobstructed. -->
      <Grid Grid.Row="0" Grid.RowSpan="6" ColumnDefinitions="320,*"
            Classes="navigationOverlay" Classes.open="{Binding IsNavigationPaneOpen}">
        <Button Grid.ColumnSpan="2" Classes="navigationScrim" Padding="0" Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseNavigationPaneCommand}" />
        <Border Grid.Column="0" Classes="navigationPane" Background="{DynamicResource NavigationPaneBrush}"
                BorderBrush="{DynamicResource CalculatorBorderBrush}" BorderThickness="0,0,1,0"
                CornerRadius="0,8,8,0" ClipToBounds="True"
                BoxShadow="8 0 18 0 #50000000">
          <Border.Transitions>
            <Transitions>
              <ThicknessTransition Property="Margin" Duration="0:0:0.22">
                <ThicknessTransition.Easing>
                  <CubicEaseOut />
                </ThicknessTransition.Easing>
              </ThicknessTransition>
            </Transitions>
          </Border.Transitions>
          <Grid RowDefinitions="54,*,60">
            <Grid Grid.Row="0" ColumnDefinitions="56,*">
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,4,0,6">
                <TextBlock Margin="16,11,8,5" FontSize="19" FontWeight="Medium" Opacity="0.62"
                           Text="{Binding CalculatorGroupName}" />
                <ItemsControl ItemsSource="{Binding CalculatorNavigationItems}"
                              ItemTemplate="{StaticResource NavigationItemTemplate}" />

                <TextBlock Margin="16,18,8,5" FontSize="19" FontWeight="Medium" Opacity="0.62"
                           Text="{Binding ConverterGroupName}" />
                <ItemsControl ItemsSource="{Binding ConverterNavigationItems}"
                              ItemTemplate="{StaticResource NavigationItemTemplate}" />
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Height="1" Margin="0" VerticalAlignment="Top"
                    Background="{DynamicResource DividerBrush}" />
            <Button Grid.Row="2" Classes="navigationItem" Margin="4,16,8,4"
                    AutomationProperties.Name="{Binding SettingsName}"
                    Command="{Binding OpenSettingsCommand}">
              <Grid ColumnDefinitions="4,38,*">
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontFamily="{StaticResource CalculatorIconFont}" FontSize="18" Text="&#xE713;" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="14" Text="{Binding SettingsName}" />
              </Grid>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- NavigationView keeps one pane-toggle button above the translating
           pane. Its behavior changes to close while open, but its hamburger
           glyph remains stable. It is locked until the pane stops moving. -->
      <Button Grid.Row="0" Classes="chromeButton navigationToggle" Margin="5,9,5,3"
              AutomationProperties.Name="Switch calculator mode"
              IsVisible="{Binding !IsAlwaysOnTop}"
              IsHitTestVisible="{Binding CanInteractWithNavigationToggle}"
              Command="{Binding ToggleNavigationPaneCommand}">
        <Grid Width="24" Height="24">
          <Canvas Classes="hamburgerGlyph" Width="24" Height="24">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18" />
          </Canvas>
        </Grid>
      </Button>

      <!-- UWP uses Flyout Placement="Full" with BackgroundSmokeFill here.
           Keep this after the NavigationView toggle so the flyout owns the
           complete calculator page's visual and input layer. The sheet matches
           the keypad's height, which only the shell can measure. -->
      <controls:HistoryPane x:Name="NarrowHistory" Grid.Row="0" Grid.RowSpan="6" ZIndex="12"
                            IsDocked="False"
                            IsVisible="{Binding IsNarrowHistoryPaneVisible}"
                            SheetHeight="{Binding #CalculatorKeypadRegion.Bounds.Height}" />
      </Grid>

      <!-- Settings mirrors the source page's Appearance and About groups. -->
      <Grid Grid.Row="1" Grid.RowSpan="6" Background="Transparent"
            RowDefinitions="54,*" IsVisible="{Binding IsSettingsOpen}">
        <Grid.Resources>
          <!-- The outer Settings card owns its fill, border, and radius. Do not
               let Fluent draw a second inset ToggleButton surface inside it. -->
          <Thickness x:Key="ExpanderHeaderPadding">0</Thickness>
          <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="Transparent" />
          <Thickness x:Key="ExpanderContentPadding">0</Thickness>
          <Thickness x:Key="ExpanderContentLeftBorderThickness">0</Thickness>
          <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
          <Thickness x:Key="ExpanderContentRightBorderThickness">0</Thickness>
          <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBorderBrushDisabled" Color="Transparent" />
          <x:Double x:Key="ExpanderChevronButtonSize">0</x:Double>
          <Thickness x:Key="ExpanderChevronMargin">0</Thickness>
          <SolidColorBrush x:Key="ExpanderChevronForeground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronForegroundDisabled" Color="Transparent" />
        </Grid.Resources>
        <Grid Grid.Row="0" IsVisible="{Binding UsesWindowsWindowControls}">
          <TextBlock Classes="pageHeading" Margin="24,0,0,0" VerticalAlignment="Center"
                     Text="{Binding SettingsName}" />
        </Grid>
        <Grid Grid.Row="0" ColumnDefinitions="56,*" IsVisible="{Binding UsesMacOSWindowControls}">
          <Button Classes="chromeButton" Margin="5,3" FontSize="18"
                  AutomationProperties.Name="{Binding BackAutomationName}"
                  ToolTip.Tip="{Binding SettingsBackTooltip}"
                  Command="{Binding CloseSettingsCommand}">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.25"
                  Data="M 12.5,5.5 L 6,12 L 12.5,18.5 M 6,12 L 20,12" />
          </Button>
          <TextBlock Grid.Column="1" Classes="pageHeading" VerticalAlignment="Center"
                     Text="{Binding SettingsName}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionHeading" Margin="0,12,0,4"
                       Text="{Binding SettingsAppearanceName}" />

            <Border Classes="settingsCard" Background="Transparent"
                    CornerRadius="6" Padding="0" ClipToBounds="True">
              <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Height="72">
                    <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                          ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}" FontSize="20" Text="&#xE790;" />
                      <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="15" FontWeight="Normal" Text="{Binding AppThemeName}" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="13"
                                 Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                 Text="{Binding AppThemeDescription}" />
                      <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                            Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                            Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                            Data="M 1,1 L 6,6 L 11,1" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                            Background="{DynamicResource SettingsCardBorderBrush}"
                            IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Margin="68,14,16,14" Spacing="7">
                  <RadioButton GroupName="AppTheme" Content="{Binding LightThemeName}"
                               IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="Light" />
                  <RadioButton GroupName="AppTheme" Content="{Binding DarkThemeName}"
                               IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="Dark" />
                  <RadioButton GroupName="AppTheme" Content="{Binding SystemThemeName}"
                               IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}"
                               Command="{Binding SelectThemeCommand}" CommandParameter="System" />
                </StackPanel>
              </local:AnimatedSettingsExpander>
            </Border>

            <Border Classes="settingsCard" Background="Transparent"
                    CornerRadius="6" Padding="0" ClipToBounds="True">
              <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Height="72">
                    <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                          ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                 FontSize="18" FontWeight="Normal" Text="Aa" />
                      <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="15" FontWeight="Normal"
                                 Text="{Binding AppFontName}" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="13"
                                 Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                 Text="{Binding AppFontDescription}" />
                      <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                            Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                            Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                            Data="M 1,1 L 6,6 L 11,1" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                            Background="{DynamicResource SettingsCardBorderBrush}"
                            IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                  </Grid>
                </Expander.Header>
                <ui:FAComboBox Margin="68,14,16,14"
                               HorizontalAlignment="Stretch"
                               Padding="12,0,0,0"
                               VerticalContentAlignment="Center"
                               MaxDropDownHeight="360"
                               ItemsSource="{Binding AvailableFontFamilies}"
                               SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}">
                  <ui:FAComboBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <!-- TODO: If a selected device font has unusual ascent or
                           descent metrics, calculate a runtime per-font baseline
                           adjustment instead of shifting every font globally. -->
                      <TextBlock VerticalAlignment="Center"
                                 FontFamily="{Binding}" Text="{Binding}" />
                    </DataTemplate>
                  </ui:FAComboBox.ItemTemplate>
                </ui:FAComboBox>
              </local:AnimatedSettingsExpander>
            </Border>

            <StackPanel IsVisible="{Binding SupportsPlatformAppearanceSettings}">
              <Border Classes="settingsCard" Background="{DynamicResource SettingsExpanderBrush}"
                      CornerRadius="6" Padding="24,18">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock FontSize="14" FontWeight="Normal" Text="{Binding MicaEffectName}" />
                  <TextBlock Grid.Row="1" Margin="0,2,16,0" FontSize="12"
                             Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                             Text="{Binding MicaEffectDescription}" TextWrapping="Wrap" />
                  <ToggleSwitch Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center"
                                IsChecked="{Binding UseMicaEffect}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard" Margin="0,4,0,0" Background="Transparent"
                      CornerRadius="6" Padding="0" ClipToBounds="True">
                <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent">
                  <Expander.Header>
                    <Grid Height="72">
                      <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                            ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="20" Text="⌜" />
                        <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="14" FontWeight="Normal" Text="{Binding WindowCornersName}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="12"
                                   Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                   Text="{Binding WindowCornersDescription}" />
                        <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                              Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                              Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                              Data="M 1,1 L 6,6 L 11,1" />
                      </Grid>
                      <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                              Background="{DynamicResource SettingsCardBorderBrush}"
                              IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="68,14,16,14" Spacing="7">
                    <RadioButton GroupName="WindowCorners" Content="{Binding Windows10CornersName}"
                                 IsChecked="{Binding IsWindows10CornerStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowCornerStyleCommand}" CommandParameter="Windows10" />
                    <RadioButton GroupName="WindowCorners" Content="{Binding Windows11CornersName}"
                                 IsChecked="{Binding IsWindows11CornerStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowCornerStyleCommand}" CommandParameter="Windows11" />
                    <RadioButton GroupName="WindowCorners" Content="{Binding MacOSCornersName}"
                                 IsChecked="{Binding IsMacOSCornerStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowCornerStyleCommand}" CommandParameter="MacOS" />
                  </StackPanel>
                </local:AnimatedSettingsExpander>
              </Border>

              <Border Classes="settingsCard" Margin="0,4,0,0" Background="Transparent"
                      CornerRadius="6" Padding="0" ClipToBounds="True">
                <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent">
                  <Expander.Header>
                    <Grid Height="72">
                      <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center"
                            ColumnDefinitions="36,*,32" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="18" Text="•••" />
                        <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="14" FontWeight="Normal" Text="{Binding WindowControlsName}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,2,0,0" FontSize="12"
                                   Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                   Text="{Binding WindowControlsDescription}" />
                        <Path Grid.Column="2" Grid.RowSpan="2" Classes="settingsExpanderChevron"
                              Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                              Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                              Data="M 1,1 L 6,6 L 11,1" />
                      </Grid>
                      <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                              Background="{DynamicResource SettingsCardBorderBrush}"
                              IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="68,14,16,14" Spacing="7">
                    <RadioButton GroupName="WindowControls" Content="{Binding Windows10WindowControlsName}"
                                 IsChecked="{Binding IsWindows10WindowControlStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowControlStyleCommand}" CommandParameter="Windows10" />
                    <RadioButton GroupName="WindowControls" Content="{Binding Windows11WindowControlsName}"
                                 IsChecked="{Binding IsWindows11WindowControlStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowControlStyleCommand}" CommandParameter="Windows11" />
                    <RadioButton GroupName="WindowControls" Content="{Binding MacOSWindowControlsName}"
                                 IsChecked="{Binding IsMacOSWindowControlStyleSelected, Mode=OneWay}"
                                 Command="{Binding SelectWindowControlStyleCommand}" CommandParameter="MacOS" />
                  </StackPanel>
                </local:AnimatedSettingsExpander>
              </Border>
            </StackPanel>

            <TextBlock Classes="sectionHeading" Margin="0,26,0,4"
                       Text="{Binding AboutGroupName}" />
            <Border Classes="settingsCard" Background="Transparent"
                    CornerRadius="6" Padding="0" ClipToBounds="True">
              <local:AnimatedSettingsExpander Classes="settingsExpander" CornerRadius="5" IsExpanded="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent">
                <Expander.Header>
                  <Grid Height="72">
                    <Grid Classes="settingsExpanderHeader" VerticalAlignment="Center" ColumnDefinitions="36,*,32">
                      <Grid Width="24" Height="24">
                        <Border CornerRadius="3" Background="#6EC7E8" />
                        <Grid Margin="5" RowDefinitions="5,*" ColumnDefinitions="*,*" ColumnSpacing="2" RowSpacing="2">
                          <Border Grid.ColumnSpan="2" Background="#E9F7FC" />
                          <Border Grid.Row="1" Background="#315368" />
                          <Border Grid.Row="1" Grid.Column="1" Background="#315368" />
                        </Grid>
                      </Grid>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                 FontSize="14" Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                 Text="{Binding AboutVersionText}" />
                      <Path Grid.Column="2" Classes="settingsExpanderChevron"
                            Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                            Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                            Data="M 1,1 L 6,6 L 11,1" />
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" ZIndex="3"
                            Background="{DynamicResource SettingsCardBorderBrush}"
                            IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Margin="68,0,16,14" Spacing="12">
                  <Button Classes="settingsLink" Content="{Binding AboutLicenseName}" Click="License_OnClick" />
                  <Button Classes="settingsLink" Content="{Binding AboutServicesName}" Click="ServicesAgreement_OnClick" />
                  <Button Classes="settingsLink" Content="{Binding AboutPrivacyName}" Click="PrivacyStatement_OnClick" />
                </StackPanel>
              </local:AnimatedSettingsExpander>
            </Border>

            <Button Classes="settingsLink" Margin="0,10,0,0" Content="{Binding FeedbackName}" Click="Feedback_OnClick" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    </Border>

    <!-- Custom chrome removes the native frame, so retain native resizing through
         narrow hit targets at each edge and corner. -->
    <Grid RowDefinitions="7,*,7" ColumnDefinitions="7,*,7"
          IsVisible="{Binding UsesCustomResizeHandles}">
      <Border Grid.Row="0" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeNorthWest_OnPointerPressed" />
      <Border Grid.Row="0" Grid.Column="1" Background="Transparent"
              PointerPressed="ResizeNorth_OnPointerPressed" />
      <Border Grid.Row="0" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeNorthEast_OnPointerPressed" />
      <Border Grid.Row="1" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeWest_OnPointerPressed" />
      <Border Grid.Row="1" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeEast_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="0" Background="Transparent"
              PointerPressed="ResizeSouthWest_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="1" Background="Transparent"
              PointerPressed="ResizeSouth_OnPointerPressed" />
      <Border Grid.Row="2" Grid.Column="2" Background="Transparent"
              PointerPressed="ResizeSouthEast_OnPointerPressed" />
    </Grid>
  </Grid>
</Window>
