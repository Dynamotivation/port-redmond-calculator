<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Calculator.Avalonia"
        xmlns:managed="using:Calculator.Managed"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:shell="using:Calculator.Avalonia.Shell"
        xmlns:controls="using:Calculator.Avalonia.Controls"
        xmlns:views="using:Calculator.Avalonia.Views"
        xmlns:graphing="using:Calculator.Avalonia.Views.Graphing"
        xmlns:shared="using:Redmond.Avalonia.Controls"
        x:Class="Calculator.Avalonia.MainWindow"
        x:DataType="managed:CalculatorViewModel"
        Width="524" Height="773"
        MinWidth="320" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#202027"
        Title="{Binding ApplicationName}">

  <Grid>
    <Border x:Name="WindowSurface"
            Classes="windowSurface"
            Classes.noBackdrop="{Binding !Settings.UseMicaEffect}"
            Classes.inactive="{Binding !IsActive, RelativeSource={RelativeSource AncestorType=Window}}"
            Classes.nativeFrame="{Binding UsesNativeWindowGeometry}"
            Classes.squareCorners="{Binding UsesSquareWindowCorners}"
            ClipToBounds="True"
            BorderBrush="{DynamicResource CalculatorBorderBrush}">
    <Border.Transitions>
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25">
          <BrushTransition.Easing>
            <SplineEasing X1="0.55" Y1="0.55" X2="0" Y2="1" />
          </BrushTransition.Easing>
        </BrushTransition>
      </Transitions>
    </Border.Transitions>
    <Grid RowDefinitions="Auto,48,22*,72*,0,32*,308*">
      <shell:WindowChrome Grid.Row="0" x:Name="TitleBarChrome" />

      <!-- Calculator and Settings are separate page surfaces beneath the
           shared title bar. Keep the inactive page out of layout and hit
           testing instead of covering it with a transparent overlay. -->
      <Grid Grid.Row="1" Grid.RowSpan="6" RowDefinitions="48,22*,72*,0,32*,308*"
            IsVisible="{Binding !IsSettingsOpen}">
      <Grid x:Name="CalculatorResponsiveLayout" Grid.RowSpan="6" ColumnDefinitions="*,0">
      <local:NavigationCulledGrid x:Name="CalculatorPageContent" Grid.RowSpan="6"
                                 Classes="calculatorPageContent"
                                 Classes.paneOpen="{Binding IsNavigationPaneOpen}">
      <local:NavigationCulledGrid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="22*" MinHeight="0" />
        <RowDefinition Height="72*" MinHeight="20" />
        <RowDefinition Height="0" />
        <RowDefinition Height="32*" MinHeight="0" />
        <RowDefinition Height="308*" MinHeight="0" />
      </local:NavigationCulledGrid.RowDefinitions>
      <!-- Hamburger/category/history row from MainPage + Calculator. -->
      <Grid Grid.Row="0" ColumnDefinitions="68,Auto,62,*,56">
        <TextBlock Grid.Column="1" Classes="pageHeading" VerticalAlignment="Center" Text="{Binding ModeDisplayName}" />
        <Border x:Name="GraphingModeSwitch" Grid.Column="3" Grid.ColumnSpan="2"
                Classes="graphModeSwitch"
                Width="64" Height="30" Margin="0,0,12,2"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                IsVisible="False" CornerRadius="4"
                Background="{DynamicResource GraphModeSwitchTrackBrush}">
          <Grid>
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="GraphingHeaderGraphButton" Classes="graphModeButton"
                            IsChecked="True" Click="GraphingHeaderGraphButton_OnClick"
                            AutomationProperties.Name="{Binding Graphing.Strings.SwitchToEquationMode}">
                <TextBlock FontFamily="{StaticResource CalculatorIconFont}"
                           FontSize="14" Text="&#xF770;" />
              </ToggleButton>
              <ToggleButton x:Name="GraphingHeaderEquationButton" Classes="graphModeButton"
                            Click="GraphingHeaderEquationButton_OnClick"
                            AutomationProperties.Name="{Binding Graphing.Strings.SwitchToGraphMode}">
                <Grid Width="18" Height="18" FlowDirection="LeftToRight">
                  <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                             FontFamily="{StaticResource CalculatorIconFont}"
                             FontSize="12" Text="&#xF893;" />
                  <TextBlock Margin="10,7,0,0" FontSize="10" FontWeight="Light" Text="x" />
                </Grid>
              </ToggleButton>
            </StackPanel>
            <Border Classes="graphModeSwitchOutline"
                    BorderBrush="{DynamicResource AccentButtonBrush}"
                    BorderThickness="1" CornerRadius="4"
                    IsHitTestVisible="False" />
          </Grid>
        </Border>
        <Button Grid.Column="2" Classes="chromeButton" Margin="10,3,0,3"
                AutomationProperties.Name="{Binding AlwaysOnTopAutomationName}"
                IsVisible="{Binding CanEnterAlwaysOnTop}"
                ToolTip.Placement="Bottom"
                Click="AlwaysOnTop_OnClick">
          <ToolTip.Tip>
            <TextBlock Text="{Binding AlwaysOnTopTooltip}" />
          </ToolTip.Tip>
          <TextBlock Classes="alwaysOnTopGlyph" Text="{Binding AlwaysOnTopGlyph}" />
        </Button>
        <Button x:Name="HistoryButton" Grid.Column="4" Classes="chromeButton"
                AutomationProperties.Name="{Binding History.Strings.AutomationName}"
                IsVisible="{Binding IsHistoryButtonVisible}"
                Command="{Binding History.ToggleCommand}" ToolTip.Tip="{Binding History.Strings.ToggleTooltip}">
          <Canvas Width="28" Height="28">
            <Path Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.5"
                  Data="M 6,9 A 9,9 0 1 1 5,16 M 3,6 L 3,12 L 9,12 M 14,8 L 14,14 L 18,16" />
          </Canvas>
        </Button>
      </Grid>

      <controls:CalculatorDisplay Grid.Row="1" Grid.RowSpan="2" x:Name="Display" />

      <views:ScientificDisplayControls x:Name="ScientificControls" Grid.Row="3" />

      <controls:MemoryPanel Grid.Row="4" x:Name="MemoryRow" />


      <views:ProgrammerCalculatorView x:Name="ProgrammerView" Grid.Row="3" Grid.RowSpan="3" />

      <!-- CalculatorStandardOperators + NumberPad, flattened without changing geometry. -->
      <Grid x:Name="CalculatorKeypadRegion" Grid.Row="5" IsHitTestVisible="False" />
      <views:StandardCalculatorView x:Name="StandardView" Grid.Row="5" />

      <views:ScientificCalculatorView x:Name="ScientificView" Grid.Row="5" />

      <views:UnitConverterView x:Name="ConverterView" Grid.Row="1" Grid.RowSpan="5" />
      <views:DateCalculatorView x:Name="DateView" Grid.Row="1" Grid.RowSpan="5" />
      <graphing:GraphingCalculatorView x:Name="GraphingView" Grid.Row="1" Grid.RowSpan="5" />

      </local:NavigationCulledGrid>

      <controls:HistoryPane Grid.Column="1" IsDocked="True"
                            IsVisible="{Binding IsDockedHistoryPaneVisible}" />
      </Grid>

      <!-- Source NavigationView replacement. The pane overlays content in the
           original LeftMinimal mode and keeps the title bar unobstructed. -->
      <shell:NavigationPane x:Name="ShellNavigation" Grid.Row="0" Grid.RowSpan="6" />

      <!-- UWP uses Flyout Placement="Full" with BackgroundSmokeFill here.
           Keep this after the NavigationView toggle so the flyout owns the
           complete calculator page's visual and input layer. The sheet matches
           the keypad's height, which only the shell can measure. -->
      <controls:HistoryPane x:Name="NarrowHistory" Grid.Row="0" Grid.RowSpan="6" ZIndex="12"
                            IsDocked="False"
                            IsVisible="{Binding IsNarrowHistoryPaneVisible}"
                            SheetHeight="{Binding #CalculatorKeypadRegion.Bounds.Height}" />
      </Grid>

      <views:SettingsView x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="6" />
    </Grid>
    </Border>

    <!-- Custom chrome removes the native frame, so retain native resizing
         through the shared edge and corner hit targets. -->
    <shared:WindowResizeHandles IsVisible="{Binding UsesCustomResizeHandles}" />
  </Grid>
</Window>
