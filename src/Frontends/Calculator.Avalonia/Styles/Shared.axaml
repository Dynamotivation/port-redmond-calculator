<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Calculator.Avalonia"
        xmlns:managed="using:Calculator.Managed"
        xmlns:ui="using:FluentAvalonia.UI.Controls">
  <!-- Typography and scrollbar defaults shared by every surface. -->
    <Style Selector="ScrollViewer /template/ ScrollBar">
    <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="TextBlock.pageHeading">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,-3,0,0" />
    <!-- TODO: Resolve non-default font baseline differences at runtime from
         the selected typeface's metrics; never offset the default font here. -->
    </Style>
    <Style Selector="TextBlock.sectionHeading">
    <Setter Property="FontSize" Value="14.7" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="RenderTransform" Value="translate(0px, -1px)" />
    </Style>
</Styles>
