<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Calculator.Avalonia"
        xmlns:managed="using:Calculator.Managed"
        xmlns:ui="using:FluentAvalonia.UI.Controls">
  <!-- Scientific small/medium/large size-class overrides. -->
    <!-- UWP CalculatorScientificOperators uses control-local size triggers, not
       window breakpoints. These classes are switched from the panel's own
       arranged size in MainWindow.axaml.cs. -->
    <Style Selector="Grid.scientificSmall Button.calcButton">
    <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Grid.scientificSmall Button.calcButton.numeric">
    <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Grid.scientificSmall Button.calcButton.symbolOperator">
    <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Grid.scientificSmall StackPanel.scientificOperatorPanel">
    <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="Grid.scientificSmall TextBlock.operatorPanelText">
    <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Grid.scientificSmall TextBlock.operatorPanelGlyph">
    <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Grid.scientificSmall TextBlock.operatorPanelChevron">
    <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Grid.scientificMedium Button.calcButton">
    <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Grid.scientificMedium Button.calcButton.numeric">
    <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="Grid.scientificMedium Button.calcButton.symbolOperator">
    <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Grid.scientificMedium StackPanel.scientificOperatorPanel">
    <Setter Property="Height" Value="70" />
    </Style>
    <Style Selector="Grid.scientificMedium TextBlock.operatorPanelText">
    <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Grid.scientificMedium TextBlock.operatorPanelGlyph">
    <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Grid.scientificMedium TextBlock.operatorPanelChevron">
    <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Grid.scientificLarge Button.calcButton">
    <Setter Property="FontSize" Value="34" />
    </Style>
    <Style Selector="Grid.scientificLarge Button.calcButton.numeric">
    <Setter Property="FontSize" Value="38" />
    </Style>
    <Style Selector="Grid.scientificLarge Button.calcButton.symbolOperator">
    <Setter Property="FontSize" Value="34" />
    </Style>
    <Style Selector="Grid.scientificLarge StackPanel.scientificOperatorPanel">
    <Setter Property="Height" Value="70" />
    </Style>
    <Style Selector="Grid.scientificLarge TextBlock.operatorPanelText">
    <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="Grid.scientificLarge TextBlock.operatorPanelGlyph">
    <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="Grid.scientificLarge TextBlock.operatorPanelChevron">
    <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Grid.scientificError Button.scientificErrorDisabled">
    <Setter Property="IsEnabled" Value="False" />
    </Style>
</Styles>
