<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.graphCommandButton">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.graphCommandButton">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.graphCommandButton:checked">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBrush}" />
  </Style>
  <Style Selector="Button.calcButton.graphSecond.selected">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBrush}" />
    <Setter Property="Foreground" Value="#101010" />
  </Style>
  <Style Selector="Border.graphEquationCard Button.graphEquationAction">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.graphEquationCard:pointerover Button.graphEquationAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource OperatorButtonOpaqueHoverBrush}" />
  </Style>
  <Style Selector="Border.graphEquationCard:pointerover Button.graphEquationAction:pressed">
    <Setter Property="Background" Value="{DynamicResource OperatorButtonOpaquePressedBrush}" />
  </Style>
  <Style Selector="Border.graphEquationCard:pointerover Button.graphEquationAction">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.graphEquationCard Button.graphEquationClear">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.graphEquationCard Button.graphEquationClear:pointerover">
    <Setter Property="Background" Value="{DynamicResource OperatorButtonOpaqueHoverBrush}" />
  </Style>
  <Style Selector="Border.graphEquationCard Border.graphEquationOutline">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.graphEquationCard:pointerover Border.graphEquationOutline">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.graphEquationCard.focused Border.graphEquationOutline">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.graphEquationToggle Border.graphEquationTileShade">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ToggleButton.graphEquationToggle TextBlock.graphEquationHideIcon">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ToggleButton.graphEquationToggle TextBlock.graphEquationShowIcon">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ToggleButton.graphEquationToggle:pointerover StackPanel.graphEquationFunction">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ToggleButton.graphEquationToggle:pointerover Border.graphEquationTileShade">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.graphEquationToggle:pointerover TextBlock.graphEquationHideIcon">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.graphEquationToggle:pointerover TextBlock.graphEquationShowIcon">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.calcButton.graphOperatorText">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.calcButton.graphParenthesis">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Grid#GraphKeypad Button.calcButton">
    <Setter Property="Margin" Value="1" />
  </Style>
  <Style Selector="Button.graphSelectorButton">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
  </Style>
  <Style Selector="Button.graphFlyoutKey">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ToggleButton.graphFlyoutKey">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ToggleButton.graphModeButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.graphModeButton:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.graphModeButton:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.graphModeButton:checked">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource GraphModeSwitchSelectedForegroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.graphModeButton:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentButtonHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.graphModeButton:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentButtonPressedBrush}" />
  </Style>
  <Style Selector="Border.graphModeSwitch:pointerover Border.graphModeSwitchOutline">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonHoverBrush}" />
  </Style>
  <Style Selector="Button.graphLinkButton">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="RadioButton.graphSegment">
    <Setter Property="Padding" Value="7,6" />
    <Setter Property="Background" Value="{DynamicResource OperatorButtonOpaqueBrush}" />
  </Style>
  <Style Selector="RadioButton.graphSegment:checked">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBrush}" />
  </Style>
  <Style Selector="RadioButton.graphColorSwatch">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border x:Name="SelectionRing"
                  Width="42" Height="42"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  CornerRadius="21"
                  BorderBrush="Transparent" BorderThickness="2" />
          <Border Width="36" Height="36"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  CornerRadius="18"
                  Background="{TemplateBinding Background}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.graphColorSwatch:pointerover /template/ Border#SelectionRing">
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="RadioButton.graphColorSwatch:checked /template/ Border#SelectionRing">
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBlock.analysisMath">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
</Styles>
