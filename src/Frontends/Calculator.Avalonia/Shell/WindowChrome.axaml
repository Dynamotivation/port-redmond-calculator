<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:managed="using:Calculator.Managed"
             x:Class="Calculator.Avalonia.Shell.WindowChrome"
             x:DataType="managed:CalculatorViewModel">
  <!-- Source-faithful replacement for CalculatorApp.TitleBar. Window
       operations are raised as events rather than performed here: this control
       owns the presentation of the title bar, not the window's lifetime. -->
  <Grid Height="42" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="Transparent"
        PointerPressed="TitleBar_OnPointerPressed">
    <StackPanel Orientation="Horizontal" IsVisible="{Binding UsesWindowsWindowControls}">
      <Button Classes="titleButton" IsVisible="{Binding ShowsWindowsAlwaysOnTopExit}"
              AutomationProperties.Name="{Binding AlwaysOnTopAutomationName}"
              ToolTip.Tip="{Binding AlwaysOnTopTooltip}"
              Click="AlwaysOnTop_OnClick">
        <TextBlock Classes="alwaysOnTopGlyph" Text="{Binding AlwaysOnTopGlyph}" />
      </Button>
      <Button Classes="titleButton" IsVisible="{Binding ShowsSettingsBackInTitleBar}"
              AutomationProperties.Name="{Binding BackAutomationName}"
              ToolTip.Tip="{Binding SettingsBackTooltip}"
              Command="{Binding CloseSettingsCommand}">
        <Path Width="18" Height="18" Stretch="Uniform"
              Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.25"
              Data="M 12.5,5.5 L 6,12 L 12.5,18.5 M 6,12 L 20,12" />
      </Button>
      <Grid Width="22" Height="22" Margin="18,10,12,10">
        <Border CornerRadius="2" Background="#6EC7E8" />
        <Grid Margin="5" RowDefinitions="5,*" ColumnDefinitions="*,*" ColumnSpacing="2" RowSpacing="2">
          <Border Grid.ColumnSpan="2" Background="#E9F7FC" />
          <Border Grid.Row="1" Background="#315368" />
          <Border Grid.Row="1" Grid.Column="1" Background="#315368" />
        </Grid>
      </Grid>
      <TextBlock Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 FontSize="13.2"
                 TextTrimming="CharacterEllipsis"
                 Text="{Binding TitleBarApplicationName}" />
    </StackPanel>
    <Button Grid.Column="0" Margin="72,0,0,0" Classes="titleButton"
            IsVisible="{Binding ShowsMacOSAlwaysOnTopExit}"
            AutomationProperties.Name="{Binding AlwaysOnTopAutomationName}"
            ToolTip.Tip="{Binding AlwaysOnTopTooltip}"
            Click="AlwaysOnTop_OnClick">
      <TextBlock Classes="alwaysOnTopGlyph" Text="{Binding AlwaysOnTopGlyph}" />
    </Button>
    <Button Grid.Column="2" Classes="titleButton captionButton"
            Classes.windows10="{Binding IsWindows10WindowControlStyleSelected}"
            IsVisible="{Binding UsesWindowsWindowControls}"
            AutomationProperties.Name="Minimize" Click="Minimize_OnClick">
      <Grid Width="12.9" Height="12.9">
        <Border Width="10" Height="1"
                Background="{DynamicResource ChromeForegroundBrush}"
                IsVisible="{Binding IsWindows10WindowControlStyleSelected}" />
        <Path Width="12.9" Height="12.9" Stretch="None"
              Stroke="{DynamicResource ChromeForegroundBrush}" StrokeThickness="1.25"
              StrokeLineCap="Round" Data="M 0.75,6.45 L 12.15,6.45"
              IsVisible="{Binding !IsWindows10WindowControlStyleSelected}" />
      </Grid>
    </Button>
    <Button Grid.Column="3" Classes="titleButton captionButton"
            Classes.windows10="{Binding IsWindows10WindowControlStyleSelected}"
            IsVisible="{Binding ShowsWindowsMaximizeButton}"
            AutomationProperties.Name="Maximize" Click="Maximize_OnClick">
      <Grid Width="12.9" Height="12.9">
        <Path Width="12" Height="12" Stretch="Uniform"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1"
              Data="M 1.5,1.5 L 10.5,1.5 L 10.5,10.5 L 1.5,10.5 Z"
              IsVisible="{Binding IsWindows10WindowControlStyleSelected}" />
        <Path Width="12.9" Height="12.9" Stretch="Uniform"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
              Data="M 3,1.75 L 9.5,1.75 Q 10.75,1.75 10.75,3 L 10.75,9.5 Q 10.75,10.75 9.5,10.75 L 3,10.75 Q 1.75,10.75 1.75,9.5 L 1.75,3 Q 1.75,1.75 3,1.75 Z"
              IsVisible="{Binding !IsWindows10WindowControlStyleSelected}" />
      </Grid>
    </Button>
    <Button Grid.Column="4" Classes="titleButton captionButton close"
            Classes.windows10="{Binding IsWindows10WindowControlStyleSelected}"
            IsVisible="{Binding UsesWindowsWindowControls}"
            AutomationProperties.Name="Close" Click="Close_OnClick">
      <Grid Width="12.9" Height="12.9">
        <Path Width="12" Height="12" Stretch="Uniform"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1"
              Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5"
              IsVisible="{Binding IsWindows10WindowControlStyleSelected}" />
        <Path Width="12.9" Height="12.9" Stretch="Uniform"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.25" StrokeLineCap="Round"
              Data="M 2.25,2.25 L 10.25,10.25 M 10.25,2.25 L 2.25,10.25"
              IsVisible="{Binding !IsWindows10WindowControlStyleSelected}" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
