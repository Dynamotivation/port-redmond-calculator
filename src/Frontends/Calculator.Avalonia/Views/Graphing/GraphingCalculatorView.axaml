<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:managed="using:Calculator.Managed"
             xmlns:graphing="using:Calculator.Avalonia.Views.Graphing"
             x:Class="Calculator.Avalonia.Views.Graphing.GraphingCalculatorView"
             x:DataType="managed:CalculatorViewModel"
             IsVisible="{Binding IsGraphingMode}">
  <Grid x:Name="Root">
    <Grid x:Name="ResponsiveLayout" ColumnDefinitions="2*,360">
      <Border x:Name="GraphPanel" Grid.Column="0" ClipToBounds="True"
              Background="{DynamicResource GraphPlotBackgroundBrush}">
        <Grid>
          <graphing:GraphCanvas x:Name="Plot"
                                Focusable="True"
                                ViewModel="{Binding Graphing}"
                                PlotBackground="{DynamicResource GraphPlotBackgroundBrush}"
                                GridBrush="{DynamicResource GraphGridBrush}"
                                AxisBrush="{DynamicResource GraphAxisBrush}" />
          <graphing:GraphTraceOverlay x:Name="TraceOverlay" />

          <!-- Sharing is intentionally absent: it is not a hidden or disabled command. -->
          <Border MinHeight="40" Margin="0,8,8,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  CornerRadius="8"
                  Background="{DynamicResource GraphCommandPanelBrush}"
                  BorderBrush="{DynamicResource GraphCommandPanelBorderBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="TraceButton" Classes="graphCommandButton"
                            Margin="4"
                            Click="TraceButton_OnClick"
                            AutomationProperties.Name="{Binding Graphing.Strings.StartTracingTooltip}"
                            ToolTip.Tip="{Binding Graphing.Strings.StartTracingTooltip}">
                <TextBlock FontFamily="{StaticResource CalculatorIconFont}"
                           FontSize="16" Text="&#xE3B3;" />
              </ToggleButton>
              <Button x:Name="GraphOptionsButton" Classes="graphCommandButton"
                      Margin="4"
                      Click="GraphOptionsButton_OnClick"
                      AutomationProperties.Name="{Binding Graphing.Strings.GraphOptionsHeading}"
                      ToolTip.Tip="{Binding Graphing.Strings.GraphOptionsHeading}">
                <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="16" Text="&#xE3B4;" />
              </Button>
            </StackPanel>
          </Border>

          <Border MinWidth="40" Margin="0,0,8,8"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  CornerRadius="8"
                  Background="{DynamicResource GraphCommandPanelBrush}"
                  BorderBrush="{DynamicResource GraphCommandPanelBorderBrush}"
                  BorderThickness="1">
            <StackPanel>
              <Button x:Name="ZoomInButton"
                      Classes="graphCommandButton" Click="ZoomIn_OnClick"
                      Margin="4"
                      AutomationProperties.Name="Zoom in"
                      ToolTip.Tip="{Binding Graphing.Strings.ZoomInTooltip}">
                <TextBlock Classes="graphCommandGlyph"
                           FontFamily="{StaticResource CalculatorIconFont}"
                           FontSize="14" Text="&#xE948;" />
              </Button>
              <Button x:Name="ZoomOutButton"
                      Classes="graphCommandButton" Click="ZoomOut_OnClick"
                      Margin="4,0"
                      AutomationProperties.Name="Zoom out"
                      ToolTip.Tip="{Binding Graphing.Strings.ZoomOutTooltip}">
                <TextBlock Classes="graphCommandGlyph"
                           FontFamily="{StaticResource CalculatorIconFont}"
                           FontSize="14" Text="&#xE949;" />
              </Button>
              <ToggleButton x:Name="GraphViewButton"
                            Classes="graphCommandButton graphViewToggle"
                            Click="GraphViewButton_OnClick"
                            Margin="4"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeForegroundBrush}"
                            AutomationProperties.Name="Graph view">
                <Grid Width="18" Height="18">
                  <TextBlock x:Name="GraphViewGlyph"
                             Classes="graphCommandGlyph"
                             FontFamily="{StaticResource CalculatorIconFont}"
                             FontSize="15"
                             Text="&#xE45E;" />
                  <TextBlock x:Name="GraphViewFillGlyph"
                             Classes="graphCommandGlyph graphViewFillGlyph"
                             FontFamily="{StaticResource CalculatorIconFont}"
                             FontSize="15"
                             Text="&#xE45D;" />
                </Grid>
              </ToggleButton>
            </StackPanel>
          </Border>

          <Popup x:Name="GraphOptionsPopup"
                 PlacementTarget="{Binding #GraphOptionsButton}"
                 Placement="BottomEdgeAlignedRight"
                 PlacementConstraintAdjustment="SlideX,SlideY,ResizeX,ResizeY"
                 VerticalOffset="4">
            <Border x:Name="GraphOptionsPanel" Width="318" MaxHeight="468"
                    Padding="18,14" CornerRadius="8"
                    Background="{DynamicResource CardBrush}" BoxShadow="0 6 18 0 #70000000">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="9">
                  <TextBlock FontSize="20" FontWeight="Medium"
                             Text="{Binding Graphing.Strings.GraphOptionsHeading}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                               Text="{Binding Graphing.Strings.WindowHeading}" />
                    <Button Grid.Column="1" Classes="graphLinkButton" Click="ResetView_OnClick"
                            Content="{Binding Graphing.Strings.ResetViewText}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <StackPanel>
                      <TextBlock Opacity="0.72" Text="{Binding Graphing.Strings.XMinimumHeading}" />
                      <TextBox x:Name="XMinimumBox" Text="-10" LostFocus="BoundsBox_OnLostFocus" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Opacity="0.72" Text="{Binding Graphing.Strings.XMaximumHeading}" />
                      <TextBox x:Name="XMaximumBox" Text="10" LostFocus="BoundsBox_OnLostFocus" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                      <TextBlock Opacity="0.72" Text="{Binding Graphing.Strings.YMinimumHeading}" />
                      <TextBox x:Name="YMinimumBox" Text="-10" LostFocus="BoundsBox_OnLostFocus" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                      <TextBlock Opacity="0.72" Text="{Binding Graphing.Strings.YMaximumHeading}" />
                      <TextBox x:Name="YMaximumBox" Text="10" LostFocus="BoundsBox_OnLostFocus" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding Graphing.Strings.UnitsHeading}" />
                  <UniformGrid Columns="3">
                    <RadioButton Classes="graphSegment" GroupName="GraphUnits" IsChecked="True"
                                 Content="{Binding Graphing.Strings.RadiansText}" />
                    <RadioButton Classes="graphSegment" GroupName="GraphUnits"
                                 Content="{Binding Graphing.Strings.DegreesText}" />
                    <RadioButton Classes="graphSegment" GroupName="GraphUnits"
                                 Content="{Binding Graphing.Strings.GradiansText}" />
                  </UniformGrid>
                  <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding Graphing.Strings.LineThicknessHeading}" />
                  <ComboBox x:Name="LineWidthBox" SelectedIndex="1" SelectionChanged="LineWidthBox_OnSelectionChanged">
                    <ComboBoxItem AutomationProperties.Name="{Binding Graphing.Strings.SmallLineWidthName}" Tag="1">
                      <Border Width="200" Height="1" Background="{DynamicResource ChromeForegroundBrush}" />
                    </ComboBoxItem>
                    <ComboBoxItem AutomationProperties.Name="{Binding Graphing.Strings.MediumLineWidthName}" Tag="2">
                      <Border Width="200" Height="2" Background="{DynamicResource ChromeForegroundBrush}" />
                    </ComboBoxItem>
                    <ComboBoxItem AutomationProperties.Name="{Binding Graphing.Strings.LargeLineWidthName}" Tag="3">
                      <Border Width="200" Height="3" Background="{DynamicResource ChromeForegroundBrush}" />
                    </ComboBoxItem>
                    <ComboBoxItem AutomationProperties.Name="{Binding Graphing.Strings.ExtraLargeLineWidthName}" Tag="4">
                      <Border Width="200" Height="4" Background="{DynamicResource ChromeForegroundBrush}" />
                    </ComboBoxItem>
                  </ComboBox>
                  <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding Graphing.Strings.GraphThemeHeading}" />
                  <RadioButton x:Name="AlwaysLightThemeButton" GroupName="GraphTheme" IsChecked="True"
                               IsCheckedChanged="GraphTheme_OnChanged"
                               Content="{Binding Graphing.Strings.AlwaysLightText}" />
                  <RadioButton x:Name="MatchAppThemeButton" GroupName="GraphTheme"
                               IsCheckedChanged="GraphTheme_OnChanged"
                               Content="{Binding Graphing.Strings.MatchAppThemeText}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>

          <Border x:Name="TraceLiveRegion" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  IsVisible="False" Opacity="0"
                  AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Border>

      <Border x:Name="EquationPanel" Grid.Column="1" Background="{DynamicResource GraphEquationPanelBrush}">
        <Grid>
        <Grid x:Name="EquationEditorSurface" IsVisible="{Binding !Graphing.IsAnalysisVisible}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2.2*" MaxHeight="400" />
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl Margin="0" VerticalAlignment="Top"
                            ItemsSource="{Binding Graphing.Equations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="managed:GraphEquationViewModel">
                  <Grid Margin="1.75,1.75,1.75,0" Height="44" VerticalAlignment="Top">
                    <Border Classes="graphEquationCard"
                            Classes.error="{Binding HasError}" Height="44"
                            VerticalAlignment="Top" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource GraphEquationCardBrush}">
                      <Grid ColumnDefinitions="44,*,Auto">
                        <ToggleButton Classes="graphEquationToggle"
                                      Margin="0" Padding="0" CornerRadius="0"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                                      IsEnabled="{Binding CanToggleVisibility}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding VisibilityAutomationName}">
                          <Border Width="44" Height="44" Background="{Binding TileColor}"
                                  CornerRadius="5">
                            <Grid>
                              <StackPanel Classes="graphEquationFunction"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource CalculatorIconFont}"
                                           FontSize="19" Foreground="White" Text="&#xF893;" />
                                <TextBlock Margin="-4,13,0,0" FontSize="12"
                                           Foreground="White" Text="{Binding FunctionIndexLabel}" />
                              </StackPanel>
                              <Border Classes="graphEquationTileShade"
                                      Background="#48000000" CornerRadius="5" />
                              <TextBlock Classes="graphEquationHideIcon"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding IsEnabled}"
                                         FontFamily="{StaticResource CalculatorIconFont}"
                                         FontSize="17" Foreground="White" Text="&#xF6AC;" />
                              <TextBlock Classes="graphEquationShowIcon"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding !IsEnabled}"
                                         FontFamily="{StaticResource CalculatorIconFont}"
                                         FontSize="17" Foreground="White" Text="&#xE890;" />
                            </Grid>
                          </Border>
                        </ToggleButton>
                        <TextBox x:Name="EquationExpressionTextBox"
                                 Grid.Column="1" Height="44" Padding="10,0"
                                 Classes="graphEquationInput"
                                 IsVisible="{Binding !ShowFormattedExpression}"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource GraphEquationFont}"
                                 FontSize="14" FontWeight="Normal"
                                 Text="{Binding DraftExpression, Mode=TwoWay}"
                                 AutomationProperties.Name="Open the context menu for available actions"
                                 AutomationProperties.HelpText="{Binding ErrorMessage}"
                                 GotFocus="EquationTextBox_OnGotFocus"
                                 LostFocus="EquationTextBox_OnLostFocus"
                                 Loaded="EquationTextBox_OnLoaded">
                          <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                          </TextBox.Resources>
                        </TextBox>
                        <TextBlock Grid.Column="1" Margin="10,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   IsVisible="{Binding ShowPlaceholder}"
                                   FontSize="14" FontWeight="Normal"
                                   Foreground="{DynamicResource SettingsSecondaryForegroundBrush}"
                                   Text="{Binding Placeholder}" />
                        <graphing:EditableMathView Grid.Column="1"
                                                   Height="44" Margin="10,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding ShowFormattedExpression}"
                                                   LaTeX="{Binding FormattedExpression}"
                                                   LinearText="{Binding DraftExpression}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource ChromeForegroundColor}"
                                                   DisplayErrorInline="False"
                                                   GotFocus="FormattedEquation_OnGotFocus"
                                                   LinearEditRequested="FormattedEquation_OnLinearEditRequested"
                                                   PointerPressed="FormattedEquation_OnPointerPressed" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    IsVisible="{Binding ShowStandardEquationActions}">
                          <Button x:Name="AnalyzeEquationButton" Classes="graphEquationAction"
                                  IsEnabled="{Binding CanAnalyze}"
                                  Click="AnalyzeEquation_OnClick"
                                  AutomationProperties.Name="{Binding $parent[UserControl].DataContext.Graphing.Strings.AnalyzeFunctionTooltip}"
                                  ToolTip.Tip="{Binding $parent[UserControl].DataContext.Graphing.Strings.AnalyzeFunctionTooltip}">
                            <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="15"
                                       Text="&#xE945;" />
                          </Button>
                          <Button x:Name="EquationStyleButton" Classes="graphEquationAction"
                                  Click="StyleEquation_OnClick"
                                  AutomationProperties.Name="{Binding $parent[UserControl].DataContext.Graphing.Strings.ChangeEquationStyleTooltip}"
                                  ToolTip.Tip="{Binding $parent[UserControl].DataContext.Graphing.Strings.ChangeEquationStyleTooltip}">
                            <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="15"
                                       Text="&#xE790;" />
                          </Button>
                          <Button Classes="graphEquationAction"
                                  Click="RemoveEquation_OnClick"
                                  AutomationProperties.Name="{Binding $parent[UserControl].DataContext.Graphing.Strings.RemoveEquationTooltip}"
                                  ToolTip.Tip="{Binding $parent[UserControl].DataContext.Graphing.Strings.RemoveEquationTooltip}">
                            <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="13"
                                       Text="&#xE74D;" />
                          </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="graphEquationClear"
                                IsVisible="{Binding ShowEditingClear}"
                                Focusable="False"
                                Click="ClearEditingEquation_OnClick"
                                AutomationProperties.Name="Clear">
                          <TextBlock FontSize="20" FontWeight="Light" Text="×" />
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    IsVisible="{Binding ShowErrorIcon}">
                          <TextBlock x:Name="EquationErrorIcon"
                                     Width="32" VerticalAlignment="Center"
                                     TextAlignment="Center"
                                     Foreground="{DynamicResource GraphEquationErrorBorderBrush}"
                                     FontFamily="{StaticResource CalculatorIconFont}"
                                     FontSize="16" Text="&#xF736;"
                                     ToolTip.Tip="{Binding ErrorMessage}" />
                          <Button Classes="graphEquationErrorAction"
                                  Click="RemoveEquation_OnClick"
                                  AutomationProperties.Name="{Binding $parent[UserControl].DataContext.Graphing.Strings.RemoveEquationTooltip}"
                                  ToolTip.Tip="{Binding $parent[UserControl].DataContext.Graphing.Strings.RemoveEquationTooltip}">
                            <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="13"
                                       Text="&#xE74D;" />
                          </Button>
                        </StackPanel>
                        <Border Grid.ColumnSpan="3" Classes="graphEquationOutline"
                                IsHitTestVisible="False" CornerRadius="5"
                                BorderBrush="{Binding TileColor}" BorderThickness="1" />
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel IsVisible="{Binding Graphing.HasVariables}">
                <Rectangle Height="1" Margin="12"
                           Fill="{DynamicResource GraphCommandPanelBorderBrush}" />
                <TextBlock Margin="12,0,12,4" FontSize="15" FontWeight="SemiBold"
                           Text="{Binding Graphing.Strings.VariablesHeader}" />
                <ItemsControl ItemsSource="{Binding Graphing.Variables}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="managed:GraphVariableViewModel">
                      <Border Margin="4,3" Padding="12,0,12,6" CornerRadius="5"
                              Background="{DynamicResource GraphEquationCardBrush}">
                        <StackPanel>
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto" FlowDirection="LeftToRight">
                            <TextBlock MinWidth="16" Margin="8,8,0,0"
                                       VerticalAlignment="Center" FontSize="16"
                                       FontStyle="Italic" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" MinWidth="16" Margin="6,8,0,0"
                                       VerticalAlignment="Center" FontSize="16"
                                       FontStyle="Italic" Text="=" />
                            <TextBox Grid.Column="2" MinWidth="32" Margin="6,0,0,0"
                                     Padding="2,10,2,2" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" TextAlignment="Center"
                                     Background="Transparent" FontStyle="Italic"
                                     Text="{Binding Value, Mode=TwoWay}" />
                            <ToggleButton Grid.Column="3" Width="32" Height="32"
                                          Margin="4,6,0,0" Padding="4"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding AreSettingsVisible, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding $parent[UserControl].DataContext.Graphing.Strings.VariableOptionsTooltip}"
                                          ToolTip.Tip="{Binding $parent[UserControl].DataContext.Graphing.Strings.VariableOptionsTooltip}">
                              <TextBlock FontFamily="{StaticResource CalculatorIconFont}"
                                         FontSize="12" Text="&#xE70D;" />
                            </ToggleButton>
                          </Grid>
                          <Slider Margin="8,0,8,-2"
                                  Minimum="{Binding Minimum}"
                                  Maximum="{Binding Maximum}"
                                  TickFrequency="{Binding Step}"
                                  Value="{Binding Value, Mode=TwoWay}" />
                          <Grid Margin="8,4,8,0" ColumnDefinitions="*,*,*" ColumnSpacing="8"
                                IsVisible="{Binding AreSettingsVisible}">
                            <StackPanel>
                              <TextBlock Opacity="0.72" FontSize="12"
                                         Text="{Binding $parent[UserControl].DataContext.Graphing.Strings.VariableMinimumHeading}" />
                              <TextBox Text="{Binding Minimum, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Opacity="0.72" FontSize="12"
                                         Text="{Binding $parent[UserControl].DataContext.Graphing.Strings.VariableStepHeading}" />
                              <TextBox Text="{Binding Step, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                              <TextBlock Opacity="0.72" FontSize="12"
                                         Text="{Binding $parent[UserControl].DataContext.Graphing.Strings.VariableMaximumHeading}" />
                              <TextBox Text="{Binding Maximum, Mode=TwoWay}" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="1" Margin="2,0,2,2" RowDefinitions="50,*">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="TrigButton" Classes="graphSelectorButton"
                        Click="SelectorButton_OnClick">
                  <Button.Content>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,2,8,0" VerticalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}"
                                 Text="&#xF892;" />
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding Graphing.Strings.TrigonometryText}" />
                      <TextBlock Margin="8,4,0,0" VerticalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}" Text="&#xE70D;" />
                    </StackPanel>
                  </Button.Content>
                  <Button.Flyout>
                    <Flyout Placement="Top">
                      <UniformGrid Columns="4" Rows="2" Width="200" Height="100">
                        <ToggleButton x:Name="TrigSecondButton" Classes="graphFlyoutKey"
                                      Content="2nd" Click="TrigModifier_OnClick"
                                      AutomationProperties.Name="Inverse function" />
                        <Button x:Name="TrigSinButton" Classes="graphFlyoutKey"
                                Content="sin" Tag="sin(" Click="InputButton_OnClick"
                                AutomationProperties.Name="Sine" />
                        <Button x:Name="TrigCosButton" Classes="graphFlyoutKey"
                                Content="cos" Tag="cos(" Click="InputButton_OnClick"
                                AutomationProperties.Name="Cosine" />
                        <Button x:Name="TrigTanButton" Classes="graphFlyoutKey"
                                Content="tan" Tag="tan(" Click="InputButton_OnClick"
                                AutomationProperties.Name="Tangent" />
                        <ToggleButton x:Name="TrigHypButton" Classes="graphFlyoutKey"
                                      Content="hyp" Click="TrigModifier_OnClick"
                                      AutomationProperties.Name="Hyperbolic function" />
                        <Button x:Name="TrigSecButton" Classes="graphFlyoutKey"
                                Content="sec" Tag="sec(" Click="InputButton_OnClick"
                                AutomationProperties.Name="Secant" />
                        <Button x:Name="TrigCscButton" Classes="graphFlyoutKey"
                                Content="csc" Tag="csc(" Click="InputButton_OnClick"
                                AutomationProperties.Name="Cosecant" />
                        <Button x:Name="TrigCotButton" Classes="graphFlyoutKey"
                                Content="cot" Tag="cot(" Click="InputButton_OnClick"
                                AutomationProperties.Name="Cotangent" />
                      </UniformGrid>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button x:Name="InequalitiesButton" Classes="graphSelectorButton"
                        Click="SelectorButton_OnClick">
                  <Button.Content>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,2,8,0" VerticalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}"
                                 Text="&#xF894;" />
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding Graphing.Strings.InequalitiesText}" />
                      <TextBlock Margin="8,4,0,0" VerticalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}" Text="&#xE70D;" />
                    </StackPanel>
                  </Button.Content>
                  <Button.Flyout>
                    <Flyout Placement="Top">
                      <UniformGrid Columns="5" Width="250" Height="50">
                        <Button x:Name="LessThanButton" Classes="graphFlyoutKey"
                                Content="&lt;" Tag="&lt;" Click="InputButton_OnClick"
                                AutomationProperties.Name="Less than" />
                        <Button x:Name="LessThanOrEqualButton" Classes="graphFlyoutKey"
                                Content="≤" Tag="≤"
                                Click="InputButton_OnClick"
                                AutomationProperties.Name="Less than or equal" />
                        <Button Classes="graphFlyoutKey" Content="=" Tag="="
                                Click="InputButton_OnClick" AutomationProperties.Name="Equal" />
                        <Button x:Name="GreaterThanOrEqualButton" Classes="graphFlyoutKey"
                                Content="≥" Tag="≥"
                                Click="InputButton_OnClick"
                                AutomationProperties.Name="Greater than or equal" />
                        <Button Classes="graphFlyoutKey" Content=">" Tag=">"
                                Click="InputButton_OnClick"
                                AutomationProperties.Name="Greater than" />
                      </UniformGrid>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button x:Name="FunctionsButton" Classes="graphSelectorButton"
                        Click="SelectorButton_OnClick">
                  <Button.Content>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,2,8,0" VerticalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}"
                                 Text="&#xF893;" />
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding Graphing.Strings.FunctionText}" />
                      <TextBlock Margin="8,4,0,0" VerticalAlignment="Center"
                                 FontFamily="{StaticResource CalculatorIconFont}" Text="&#xE70D;" />
                    </StackPanel>
                  </Button.Content>
                  <Button.Flyout>
                    <Flyout Placement="Top">
                      <UniformGrid Columns="3" Width="150" Height="50">
                        <Button x:Name="AbsoluteValueButton" Classes="graphFlyoutKey"
                                Content="|x|" Tag="abs(" Click="InputButton_OnClick"
                                AutomationProperties.Name="Absolute value" />
                        <Button Classes="graphFlyoutKey" Content="⌊x⌋" Tag="floor("
                                Click="InputButton_OnClick" AutomationProperties.Name="Floor" />
                        <Button Classes="graphFlyoutKey" Content="⌈x⌉" Tag="ceil("
                                Click="InputButton_OnClick" AutomationProperties.Name="Ceiling" />
                      </UniformGrid>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </ScrollViewer>

            <Grid x:Name="GraphKeypad" Grid.Row="1" Margin="1" RowDefinitions="*,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*">
              <Button x:Name="SecondButton" Classes="calcButton operator symbolOperator graphSecond" Content="&#xF897;" Click="SecondButton_OnClick" AutomationProperties.Name="Inverse function" />
              <Button Grid.Column="1" Classes="calcButton operator symbolOperator" Content="&#xF7CF;" Tag="pi" Click="InputButton_OnClick" AutomationProperties.Name="Pi" />
              <Button Grid.Column="2" Classes="calcButton operator graphOperatorText" Content="e" Tag="e" Click="InputButton_OnClick" AutomationProperties.Name="Euler's number" />
              <Button Grid.Column="3" Classes="calcButton operator graphOperatorText" Content="C" Tag="clear-input" Click="InputButton_OnClick" AutomationProperties.Name="Clear" />
              <Button Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE94F;" Tag="backspace-input" Click="InputButton_OnClick" AutomationProperties.Name="Backspace" />

              <Grid x:Name="PrimaryScientificKeys" Grid.Row="1" Grid.RowSpan="6" RowDefinitions="*,*,*,*,*,*" IsHitTestVisible="True">
                <Button Classes="calcButton operator symbolOperator" Content="&#xF7C8;" Tag="^2" Click="InputButton_OnClick" AutomationProperties.Name="Square" />
                <Button Grid.Row="1" Classes="calcButton operator symbolOperator" Content="&#xF899;" Tag="sqrt(" Click="InputButton_OnClick" AutomationProperties.Name="Square root" />
                <Button Grid.Row="2" Classes="calcButton operator symbolOperator" Content="&#xF7CA;" Tag="^" Click="InputButton_OnClick" AutomationProperties.Name="'X' to the exponent" />
                <Button Grid.Row="3" Classes="calcButton operator symbolOperator" Content="&#xF7CC;" Tag="10^(" Click="InputButton_OnClick" AutomationProperties.Name="Ten to the exponent" />
                <Button Grid.Row="4" Classes="calcButton operator graphOperatorText" Content="log" Tag="log(" Click="InputButton_OnClick" AutomationProperties.Name="Log" />
                <Button Grid.Row="5" Classes="calcButton operator graphOperatorText" Content="ln" Tag="ln(" Click="InputButton_OnClick" AutomationProperties.Name="Natural log" />
              </Grid>
              <Grid x:Name="InverseScientificKeys" Grid.Row="1" Grid.RowSpan="6" RowDefinitions="*,*,*,*,*,*" IsVisible="False">
                <Button Classes="calcButton operator symbolOperator" Content="&#xF7CB;" Tag="^3" Click="InputButton_OnClick" AutomationProperties.Name="Cube" />
                <Button Grid.Row="1" Classes="calcButton operator symbolOperator" Content="&#xF881;" Tag="cbrt(" Click="InputButton_OnClick" AutomationProperties.Name="Cube root" />
                <Button Grid.Row="2" Classes="calcButton operator symbolOperator" Content="&#xF7CD;" Tag="root(" Click="InputButton_OnClick" AutomationProperties.Name="'y' root of 'x'" />
                <Button Grid.Row="3" Classes="calcButton operator symbolOperator" Content="&#xF882;" Tag="2^(" Click="InputButton_OnClick" AutomationProperties.Name="Two to the exponent" />
                <Button Grid.Row="4" Classes="calcButton operator symbolOperator" Content="&#xF883;" Tag="log(" Click="InputButton_OnClick" AutomationProperties.Name="Log base Y" />
                <Button Grid.Row="5" Classes="calcButton operator symbolOperator" Content="&#xF7CE;" Tag="e^(" Click="InputButton_OnClick" AutomationProperties.Name="'e' to the exponent" />
              </Grid>

              <Button Grid.Row="1" Grid.Column="1" Classes="calcButton operator symbolOperator" Content="&#xF7C9;" Tag="1/(" Click="InputButton_OnClick" AutomationProperties.Name="Reciprocal" />
              <Button Grid.Row="1" Grid.Column="2" Classes="calcButton operator symbolOperator" Content="&#xF884;" Tag="abs(" Click="InputButton_OnClick" AutomationProperties.Name="Absolute value" />
              <Button Grid.Row="1" Grid.Column="3" Classes="calcButton operator graphOperatorText" Content="𝑥" Tag="x" Click="InputButton_OnClick" AutomationProperties.Name="X" />
              <Button Grid.Row="1" Grid.Column="4" Classes="calcButton operator graphOperatorText" Content="𝑦" Tag="y" Click="InputButton_OnClick" AutomationProperties.Name="Y" />
              <Button Grid.Row="2" Grid.Column="1" Classes="calcButton operator graphParenthesis" Content="(" Tag="(" Click="InputButton_OnClick" AutomationProperties.Name="Left parenthesis" />
              <Button Grid.Row="2" Grid.Column="2" Classes="calcButton operator graphParenthesis" Content=")" Tag=")" Click="InputButton_OnClick" AutomationProperties.Name="Right parenthesis" />
              <Button Grid.Row="2" Grid.Column="3" Classes="calcButton operator symbolOperator" Content="&#xE94E;" Tag="=" Click="InputButton_OnClick" AutomationProperties.Name="Equals" />
              <Button Grid.Row="2" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE94A;" Tag="/" Click="InputButton_OnClick" AutomationProperties.Name="Divide by" />
              <Button Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="7" Tag="7" Click="InputButton_OnClick" AutomationProperties.Name="Seven" />
              <Button Grid.Row="3" Grid.Column="2" Classes="calcButton numeric" Content="8" Tag="8" Click="InputButton_OnClick" AutomationProperties.Name="Eight" />
              <Button Grid.Row="3" Grid.Column="3" Classes="calcButton numeric" Content="9" Tag="9" Click="InputButton_OnClick" AutomationProperties.Name="Nine" />
              <Button Grid.Row="3" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE947;" Tag="*" Click="InputButton_OnClick" AutomationProperties.Name="Multiply by" />
              <Button Grid.Row="4" Grid.Column="1" Classes="calcButton numeric" Content="4" Tag="4" Click="InputButton_OnClick" AutomationProperties.Name="Four" />
              <Button Grid.Row="4" Grid.Column="2" Classes="calcButton numeric" Content="5" Tag="5" Click="InputButton_OnClick" AutomationProperties.Name="Five" />
              <Button Grid.Row="4" Grid.Column="3" Classes="calcButton numeric" Content="6" Tag="6" Click="InputButton_OnClick" AutomationProperties.Name="Six" />
              <Button Grid.Row="4" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE949;" Tag="-" Click="InputButton_OnClick" AutomationProperties.Name="Minus" />
              <Button Grid.Row="5" Grid.Column="1" Classes="calcButton numeric" Content="1" Tag="1" Click="InputButton_OnClick" AutomationProperties.Name="One" />
              <Button Grid.Row="5" Grid.Column="2" Classes="calcButton numeric" Content="2" Tag="2" Click="InputButton_OnClick" AutomationProperties.Name="Two" />
              <Button Grid.Row="5" Grid.Column="3" Classes="calcButton numeric" Content="3" Tag="3" Click="InputButton_OnClick" AutomationProperties.Name="Three" />
              <Button Grid.Row="5" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE948;" Tag="+" Click="InputButton_OnClick" AutomationProperties.Name="Plus" />
              <Button Grid.Row="6" Grid.Column="1" Classes="calcButton numeric symbolOperator" Content="&#xF898;" Tag="-" Click="InputButton_OnClick" AutomationProperties.Name="Positive negative" />
              <Button Grid.Row="6" Grid.Column="2" Classes="calcButton numeric" Content="0" Tag="0" Click="InputButton_OnClick" AutomationProperties.Name="Zero" />
              <Button Grid.Row="6" Grid.Column="3" Classes="calcButton numeric" Content="{Binding DecimalSeparator}" Tag="." Click="InputButton_OnClick" AutomationProperties.Name="Decimal separator" />
              <Button Grid.Row="6" Grid.Column="4" Classes="calcButton equalsButton" Content="&#xE94E;" Tag="submit-input" Click="InputButton_OnClick" AutomationProperties.Name="Submit" />
            </Grid>
          </Grid>
        </Grid>

        <Grid x:Name="AnalysisSurface"
              RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding Graphing.IsAnalysisVisible}"
              AutomationProperties.Name="{Binding Graphing.Strings.AnalysisHeading}">
          <Border Margin="4,4,4,0" MinHeight="44" CornerRadius="5"
                  Background="{DynamicResource GraphEquationCardBrush}">
            <Grid ColumnDefinitions="Auto,*">
              <Button x:Name="AnalysisBackButton"
                      MinWidth="74" MinHeight="44" Padding="8,0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Stretch"
                      Background="{Binding Graphing.SelectedEquation.Color}"
                      BorderThickness="0" CornerRadius="5"
                      Click="CloseAnalysis_OnClick"
                      AutomationProperties.Name="{Binding Graphing.Strings.AnalysisBackTooltip}"
                      ToolTip.Tip="{Binding Graphing.Strings.AnalysisBackTooltip}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Margin="0,0,7,0"
                             FontFamily="{StaticResource CalculatorIconFont}"
                             FontSize="16" Foreground="White" Text="&#xE72B;" />
                  <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                    <TextBlock FontFamily="{StaticResource CalculatorIconFont}"
                               FontSize="19" Foreground="White" Text="&#xF893;" />
                    <TextBlock Margin="-4,13,0,0" FontSize="12" Foreground="White"
                               Text="{Binding Graphing.SelectedEquation.FunctionIndexLabel}" />
                  </StackPanel>
                </StackPanel>
              </Button>
              <TextBlock Grid.Column="1" MinHeight="44" Padding="10,8,8,8"
                         VerticalAlignment="Center"
                         FontSize="14" FontStyle="Italic"
                         Text="{Binding Graphing.SelectedEquation.Expression}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding Graphing.Strings.AnalysisEquationAutomationName}" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="1" Margin="12,12,10,0"
                     FontSize="20" FontWeight="Medium"
                     Text="{Binding Graphing.Strings.AnalysisHeading}" />

          <ScrollViewer Grid.Row="2" Margin="0,4,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl x:Name="AnalysisFeatureList"
                            Margin="12,0,10,12"
                            ItemsSource="{Binding Graphing.AnalysisItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="managed:GraphAnalysisDisplayItem">
                    <StackPanel Margin="0,8,0,7"
                                AutomationProperties.Name="{Binding Title}">
                      <TextBlock FontSize="12" Opacity="0.68"
                                 Text="{Binding Title}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Values}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="managed:GraphAnalysisDisplayValue">
                            <Grid MinHeight="24" ColumnDefinitions="Auto,*">
                              <TextBlock VerticalAlignment="Center"
                                         FontSize="14"
                                         Classes.analysisMath="{Binding IsMath}"
                                         Text="{Binding Text}" TextWrapping="Wrap"
                                         AutomationProperties.Name="{Binding Text}" />
                              <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                         VerticalAlignment="Center"
                                         FontSize="14" Text="{Binding Annotation}"
                                         TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="AnalysisErrorTextBlock"
                         Margin="12,6,10,0" FontSize="14"
                         Text="{Binding Graphing.AnalysisError}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Graphing.HasAnalysisError}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>
