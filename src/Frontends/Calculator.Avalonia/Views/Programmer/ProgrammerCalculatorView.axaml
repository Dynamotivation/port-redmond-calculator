<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:managed="using:Calculator.Managed"
             x:Class="Calculator.Avalonia.Views.ProgrammerCalculatorView"
             x:DataType="managed:CalculatorViewModel"
             IsVisible="{Binding IsProgrammerMode}">
  <!-- Programmer mode keeps Microsoft's original vertical topology: four radix
       rows, a compact input/word-size selector, then the six-row, five-column
       integer keypad (or 64-bit flip surface). The control spans the same three
       rows the panel did and keeps its own 96/34/* split, so the shared grid's
       row boundaries are unchanged. -->
  <Grid x:Name="ProgrammerPanel"
        RowDefinitions="96,34,*"
        x:CompileBindings="False">
    <Grid Margin="4,0" RowDefinitions="*,*,*,*">
      <Button x:Name="ProgrammerHexRadixButton" Classes="memoryButton programmerRadix" Classes.selected="{Binding Programmer.IsHexadecimal}"
              HorizontalContentAlignment="Stretch" Padding="12,0"
              Command="{Binding Programmer.SelectRadixCommand}" CommandParameter="Hexadecimal">
        <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
          <TextBlock VerticalAlignment="Center" FontSize="12" Text="HEX" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Programmer.HexDisplay}" />
        </Grid>
      </Button>
      <Button x:Name="ProgrammerDecimalRadixButton" Grid.Row="1" Classes="memoryButton programmerRadix" Classes.selected="{Binding Programmer.IsDecimal}"
              HorizontalContentAlignment="Stretch" Padding="12,0"
              Command="{Binding Programmer.SelectRadixCommand}" CommandParameter="Decimal">
        <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
          <TextBlock VerticalAlignment="Center" FontSize="12" Text="DEC" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Programmer.DecimalDisplay}" />
        </Grid>
      </Button>
      <Button x:Name="ProgrammerOctalRadixButton" Grid.Row="2" Classes="memoryButton programmerRadix" Classes.selected="{Binding Programmer.IsOctal}"
              HorizontalContentAlignment="Stretch" Padding="12,0"
              Command="{Binding Programmer.SelectRadixCommand}" CommandParameter="Octal">
        <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
          <TextBlock VerticalAlignment="Center" FontSize="12" Text="OCT" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Programmer.OctalDisplay}" />
        </Grid>
      </Button>
      <Button x:Name="ProgrammerBinaryRadixButton" Grid.Row="3" Classes="memoryButton programmerRadix" Classes.selected="{Binding Programmer.IsBinary}"
              HorizontalContentAlignment="Stretch" Padding="12,0"
              Command="{Binding Programmer.SelectRadixCommand}" CommandParameter="Binary">
        <Grid Margin="8,0,4,0" ColumnDefinitions="48,*">
          <TextBlock VerticalAlignment="Center" FontSize="12" Text="BIN" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding Programmer.BinaryDisplay}" />
        </Grid>
      </Button>
    </Grid>

    <Grid Grid.Row="1" Margin="3,0" ColumnDefinitions="80,80,*,80">
      <Button Classes="memoryButton" FontFamily="{StaticResource CalculatorIconFont}"
              Content="&#xE75F;" Command="{Binding Programmer.ToggleBitFlipCommand}" />
      <Button Grid.Column="1" Classes="memoryButton" FontFamily="{StaticResource CalculatorIconFont}"
              Classes.selected="{Binding Programmer.IsBitFlipMode}"
              Content="&#xF7D0;" Command="{Binding Programmer.ToggleBitFlipCommand}" />
      <Button x:Name="ProgrammerWordSizeButton" Grid.Column="3" Classes="memoryButton" IsEnabled="{Binding !IsError}"
              Content="{Binding Programmer.WordSizeLabel}" Command="{Binding Programmer.CycleWordSizeCommand}" />
    </Grid>

    <Grid x:Name="ProgrammerNumpadPanel" Grid.Row="2" Margin="3,0,3,3"
          RowDefinitions="Auto,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*"
          IsVisible="{Binding !Programmer.IsBitFlipMode}">
      <StackPanel Grid.ColumnSpan="5" Classes="scientificOperatorPanel" Orientation="Horizontal">
        <Button Classes="memoryButton" IsEnabled="{Binding !IsError}">
          <Button.Content>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="16" Text="&#xF895;" />
              <TextBlock x:Name="ProgrammerBitwiseLabel" Margin="8,0,0,0" Text="{Binding Programmer.Strings.BitwiseName}" />
            </StackPanel>
          </Button.Content>
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <Grid Width="258" Height="96" RowDefinitions="*,*" ColumnDefinitions="*,*,*">
                <Button Classes="calcButton operator" Content="AND" Command="{Binding SendCommandCommand}" CommandParameter="And" />
                <Button Grid.Column="1" Classes="calcButton operator" Content="OR" Command="{Binding SendCommandCommand}" CommandParameter="Or" />
                <Button Grid.Column="2" Classes="calcButton operator" Content="NOT" Command="{Binding SendCommandCommand}" CommandParameter="Not" />
                <Button Grid.Row="1" Classes="calcButton operator" Content="NAND" Command="{Binding SendCommandCommand}" CommandParameter="Nand" />
                <Button Grid.Row="1" Grid.Column="1" Classes="calcButton operator" Content="NOR" Command="{Binding SendCommandCommand}" CommandParameter="Nor" />
                <Button Grid.Row="1" Grid.Column="2" Classes="calcButton operator" Content="XOR" Command="{Binding SendCommandCommand}" CommandParameter="Xor" />
              </Grid>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="memoryButton" IsEnabled="{Binding !IsError}">
          <Button.Content>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource CalculatorIconFont}" FontSize="16" Text="&#xF896;" />
              <TextBlock x:Name="ProgrammerBitShiftLabel" Margin="8,0,0,0" Text="{Binding Programmer.Strings.BitShiftName}" />
            </StackPanel>
          </Button.Content>
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel Width="230" Margin="8">
                <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding Programmer.Strings.ArithmeticShiftName}" IsChecked="{Binding Programmer.IsArithmeticShift}"
                             Command="{Binding Programmer.SelectShiftModeCommand}" CommandParameter="Arithmetic" />
                <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding Programmer.Strings.LogicalShiftName}" IsChecked="{Binding Programmer.IsLogicalShift}"
                             Command="{Binding Programmer.SelectShiftModeCommand}" CommandParameter="Logical" />
                <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding Programmer.Strings.RotateCircularShiftName}" IsChecked="{Binding Programmer.IsRotateShift}"
                             Command="{Binding Programmer.SelectShiftModeCommand}" CommandParameter="Rotate" />
                <RadioButton GroupName="ProgrammerShiftMode" Content="{Binding Programmer.Strings.RotateCarryShiftName}" IsChecked="{Binding Programmer.IsRotateCarryShift}"
                             Command="{Binding Programmer.SelectShiftModeCommand}" CommandParameter="RotateCarry" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <Button x:Name="ProgrammerLeftShiftButton" Grid.Row="1" Grid.Column="1"
              Classes="calcButton operator" FontFamily="{StaticResource CalculatorIconFont}"
              Content="&#xF88E;" IsEnabled="{Binding !IsError}"
              Command="{Binding Programmer.ExecuteLeftShiftCommand}" />
      <Button x:Name="ProgrammerRightShiftButton" Grid.Row="1" Grid.Column="2"
              Classes="calcButton operator" FontFamily="{StaticResource CalculatorIconFont}"
              Content="&#xF88F;" IsEnabled="{Binding !IsError}"
              Command="{Binding Programmer.ExecuteRightShiftCommand}" />
      <Grid Grid.Row="1" Grid.Column="3">
        <Button x:Name="ProgrammerClearButton" Classes="calcButton operator" Content="C"
                IsVisible="{Binding IsInputEmpty}" Command="{Binding SendCommandCommand}" CommandParameter="Clear" />
        <Button x:Name="ProgrammerClearEntryButton" Classes="calcButton operator" Content="CE"
                IsVisible="{Binding !IsInputEmpty}" Command="{Binding SendCommandCommand}" CommandParameter="ClearEntry" />
      </Grid>
      <Button x:Name="ProgrammerBackspaceButton" Grid.Row="1" Grid.Column="4"
              Classes="calcButton operator symbolOperator" Content="&#xE94F;"
              Command="{Binding SendCommandCommand}" CommandParameter="Backspace" />

      <Button x:Name="ProgrammerAButton" Grid.Row="1" Classes="calcButton numeric" Content="A" IsEnabled="{Binding Programmer.AreHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="A" />
      <Button x:Name="ProgrammerBButton" Grid.Row="2" Classes="calcButton numeric" Content="B" IsEnabled="{Binding Programmer.AreHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="B" />
      <Button x:Name="ProgrammerCButton" Grid.Row="3" Classes="calcButton numeric" Content="C" IsEnabled="{Binding Programmer.AreHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="C" />
      <Button x:Name="ProgrammerDButton" Grid.Row="4" Classes="calcButton numeric" Content="D" IsEnabled="{Binding Programmer.AreHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="D" />
      <Button x:Name="ProgrammerEButton" Grid.Row="5" Classes="calcButton numeric" Content="E" IsEnabled="{Binding Programmer.AreHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="E" />
      <Button x:Name="ProgrammerFButton" Grid.Row="6" Classes="calcButton numeric" Content="F" IsEnabled="{Binding Programmer.AreHexDigitsEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="F" />

      <Button x:Name="ProgrammerOpenParenthesisButton" Grid.Row="2" Grid.Column="1" Classes="calcButton operator" Content="(&#x2009;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="OpenParenthesis" />
      <Button x:Name="ProgrammerCloseParenthesisButton" Grid.Row="2" Grid.Column="2" Classes="calcButton operator" Content="&#x2009;)" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="CloseParenthesis" />
      <Button x:Name="ProgrammerModuloButton" Grid.Row="2" Grid.Column="3" Classes="calcButton operator" Content="%" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Modulo" />
      <Button x:Name="ProgrammerDivideButton" Grid.Row="2" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE94A;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Divide" />

      <Button x:Name="ProgrammerSevenButton" Grid.Row="3" Grid.Column="1" Classes="calcButton numeric" Content="7" IsEnabled="{Binding Programmer.AreTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Seven" />
      <Button x:Name="ProgrammerEightButton" Grid.Row="3" Grid.Column="2" Classes="calcButton numeric" Content="8" IsEnabled="{Binding Programmer.AreEightAndNineEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Eight" />
      <Button x:Name="ProgrammerNineButton" Grid.Row="3" Grid.Column="3" Classes="calcButton numeric" Content="9" IsEnabled="{Binding Programmer.AreEightAndNineEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Nine" />
      <Button x:Name="ProgrammerMultiplyButton" Grid.Row="3" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE947;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Multiply" />
      <Button x:Name="ProgrammerFourButton" Grid.Row="4" Grid.Column="1" Classes="calcButton numeric" Content="4" IsEnabled="{Binding Programmer.AreTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Four" />
      <Button x:Name="ProgrammerFiveButton" Grid.Row="4" Grid.Column="2" Classes="calcButton numeric" Content="5" IsEnabled="{Binding Programmer.AreTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Five" />
      <Button x:Name="ProgrammerSixButton" Grid.Row="4" Grid.Column="3" Classes="calcButton numeric" Content="6" IsEnabled="{Binding Programmer.AreTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Six" />
      <Button x:Name="ProgrammerSubtractButton" Grid.Row="4" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE949;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Subtract" />
      <Button x:Name="ProgrammerOneButton" Grid.Row="5" Grid.Column="1" Classes="calcButton numeric" Content="1" Command="{Binding SendCommandCommand}" CommandParameter="One" />
      <Button x:Name="ProgrammerTwoButton" Grid.Row="5" Grid.Column="2" Classes="calcButton numeric" Content="2" IsEnabled="{Binding Programmer.AreTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Two" />
      <Button x:Name="ProgrammerThreeButton" Grid.Row="5" Grid.Column="3" Classes="calcButton numeric" Content="3" IsEnabled="{Binding Programmer.AreTwoThroughSevenEnabled}" Command="{Binding SendCommandCommand}" CommandParameter="Three" />
      <Button x:Name="ProgrammerAddButton" Grid.Row="5" Grid.Column="4" Classes="calcButton operator symbolOperator" Content="&#xE948;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Add" />
      <Button x:Name="ProgrammerSignButton" Grid.Row="6" Grid.Column="1" Classes="calcButton numeric symbolOperator" Content="&#xF898;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Sign" />
      <Button x:Name="ProgrammerZeroButton" Grid.Row="6" Grid.Column="2" Classes="calcButton numeric" Content="0" Command="{Binding SendCommandCommand}" CommandParameter="Zero" />
      <Button x:Name="ProgrammerEqualsButton" Grid.Row="6" Grid.Column="4" Classes="calcButton equalsButton symbolOperator" Content="&#xE94E;" IsEnabled="{Binding !IsError}" Command="{Binding SendCommandCommand}" CommandParameter="Equals" />
    </Grid>

    <ScrollViewer Grid.Row="2" Margin="4,0,4,4" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" IsVisible="{Binding Programmer.IsBitFlipMode}">
      <ItemsControl ItemsSource="{Binding Programmer.BitGroups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="managed:CalculatorProgrammerBitGroup" x:CompileBindings="False">
            <StackPanel Width="124" Margin="2,3">
              <ItemsControl ItemsSource="{Binding Bits}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="managed:CalculatorProgrammerBit" x:CompileBindings="False">
                    <Button Height="30" Padding="0" Classes="memoryButton"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding $parent[Window].DataContext.Programmer.FlipBitCommand}"
                            CommandParameter="{Binding}">
                      <Grid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="0" IsVisible="{Binding !IsSet}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" IsVisible="{Binding IsSet}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="4,0" FontSize="11" Opacity="0.65" Text="{Binding Label}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
