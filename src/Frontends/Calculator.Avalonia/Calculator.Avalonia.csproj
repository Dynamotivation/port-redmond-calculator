<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Redmond Calculator</AssemblyName>
    <RootNamespace>Calculator.Avalonia</RootNamespace>
    <Product>Redmond Calculator</Product>
    <Authors>Redmond Calculator contributors</Authors>
    <Copyright>Copyright (c) 2026 Redmond Calculator contributors</Copyright>
    <Description>A cross-platform Avalonia calculator using the Microsoft Calculator engine.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Dynamotivation/port-redmond-calculator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>Assets/RedmondCalculatorIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The native engine is built per platform. A cross-platform publish (for example the Windows
         setup, published on Linux) passes -p:NativeCalculatorLibrary=<path to the built library>. -->
    <NativeCalculatorLibrary Condition="'$(NativeCalculatorLibrary)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProjectDirectory)/../../../build/windows-msvc/src/CalculatorNative/$(Configuration)/calculator_engine.dll</NativeCalculatorLibrary>
    <NativeCalculatorLibrary Condition="'$(NativeCalculatorLibrary)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(MSBuildProjectDirectory)/../../../build/portable/src/CalculatorNative/libcalculator_engine.dylib</NativeCalculatorLibrary>
    <NativeCalculatorFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">calculator_engine.dll</NativeCalculatorFileName>
    <NativeCalculatorFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libcalculator_engine.dylib</NativeCalculatorFileName>
    <NativeCalculatorFileName Condition="$(RuntimeIdentifier.StartsWith('win-'))">calculator_engine.dll</NativeCalculatorFileName>
    <NativeCalculatorFileName Condition="$(RuntimeIdentifier.StartsWith('osx-'))">libcalculator_engine.dylib</NativeCalculatorFileName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Calculator.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The Avalonia fork accidentally omits its editor assembly. Keep the
         fork's current CSharpMath core while supplying only the compatible
         WYSIWYG editor backend. -->
    <PackageReference Include="CSharpMath" Version="0.5.1" ExcludeAssets="All" PrivateAssets="All" />
    <PackageReference Include="CSharpMath.Editor" Version="0.5.1" />
    <PackageReference Include="Sylinko.CSharpMath.Avalonia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Calculator.Managed/Calculator.Managed.csproj" />
    <ProjectReference Include="../../Calculator.Shortcuts/Calculator.Shortcuts.csproj" />
    <ProjectReference Include="../../Calculator.ResourceLoader/Calculator.ResourceLoader.csproj" />
    <ProjectReference Include="../../../redmond-commons/Redmond.Avalonia.Controls/Redmond.Avalonia.Controls.csproj" />
    <ProjectReference Include="../../../redmond-commons/Redmond.Avalonia.Windowing/Redmond.Avalonia.Windowing.csproj" />
    <ProjectReference Include="../../../redmond-commons/Redmond.Shortcuts/Redmond.Shortcuts.csproj" />
    <AvaloniaResource Include="Assets/LatinModernMath-Regular.otf" />
    <AvaloniaResource Include="Assets/RedmondCalculatorIcon.png" />
    <AvaloniaResource Include="$(MicrosoftCalculatorRoot)/src/Calculator/Assets/CalculatorIcons.ttf" Link="Assets/CalculatorIcons.ttf" />
    <Content Include="$(MicrosoftCalculatorRoot)/src/Calculator/Resources/**/*.resw" Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildProjectDirectory)/../../../licenses/**/*"
             Exclude="$(MSBuildProjectDirectory)/../../../licenses/components.json"
             Link="Licenses/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NativeCalculatorLibrary)" Condition="'$(NativeCalculatorLibrary)' != '' and Exists('$(NativeCalculatorLibrary)')">
      <Link>$(NativeCalculatorFileName)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireNativeCalculatorLibrary" BeforeTargets="Build" Condition="'$(NativeCalculatorLibrary)' != '' and !Exists('$(NativeCalculatorLibrary)')">
    <Error Text="Native calculator library not found. Configure and build the repository CMake project first." />
  </Target>
</Project>
