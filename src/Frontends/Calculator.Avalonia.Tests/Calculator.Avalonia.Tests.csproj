<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Calculator.Avalonia.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The referenced frontend is a WinExe; suppress its entry point. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <NativeCalculatorLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(MSBuildProjectDirectory)/../../../build/portable/src/CalculatorNative/libcalculator_engine.dylib</NativeCalculatorLibrary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Calculator.Avalonia/Calculator.Avalonia.csproj" />
    <Content Include="../../Calculator/Resources/**/*.resw"
             Link="Resources/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeCalculatorLibrary)"
             Condition="'$(NativeCalculatorLibrary)' != '' and Exists('$(NativeCalculatorLibrary)')"
             Link="libcalculator_engine.dylib"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
